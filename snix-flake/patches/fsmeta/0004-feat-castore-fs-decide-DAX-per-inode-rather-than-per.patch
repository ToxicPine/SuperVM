 snix/castore/src/fs/mod.rs       |  77 +++++++++-
 2 files changed, 320 insertions(+), 2 deletions(-)
 create mode 100644 snix/castore/src/fs/dax_tests.rs

diff --git a/snix/castore/src/fs/dax_tests.rs b/snix/castore/src/fs/dax_tests.rs
new file mode 100644
index 000000000..da142fb5a
--- /dev/null
+++ b/snix/castore/src/fs/dax_tests.rs
@@ -0,0 +1,245 @@
+//! Per-inode DAX negotiation and marking.
+//!
+//! These drive the [FileSystem] trait directly rather than through a mount:
+//! `FUSE_ATTR_DAX` travels in the lookup reply, which a mounted filesystem does
+//! not expose to userspace, and reproducing the mapping itself would need a
+//! VMM. The declaration is a real file in a real castore tree, so the whole
+//! resolution path is exercised.
+
+use std::{collections::BTreeMap, ffi::CString, io::Cursor, sync::Arc};
+
+use fuse_backend_rs::{
+    abi::fuse_abi::{FUSE_ATTR_DAX, KERNEL_MINOR_VERSION},
+    api::filesystem::{Context, FileSystem, FsOptions, ROOT_ID},
+};
+use tempfile::TempDir;
+
+use crate::{
+    Directory, Node, PathComponent,
+    attrs::ATTR_DAX,
+    blobservice::{BlobService, MemoryBlobService},
+    directoryservice::DirectoryService,
+    fixtures,
+    fs::{FSSettings, SnixStoreFs, dax::DaxCache},
+};
+
+const ROOT: &str = "00000000000000000000000000000000-test";
+
+type Fs = SnixStoreFs<
+    Arc<dyn BlobService>,
+    Arc<dyn DirectoryService>,
+    Arc<BTreeMap<PathComponent, Node>>,
+>;
+
+/// A tree of `bin/hello`, `share/doc` and a declaration naming one of them.
+///
+/// Both files are the same blob, so the only thing that can distinguish them
+/// is what the tree declares.
+async fn mk_fs(declaration: &str, dax_cache: Option<DaxCache>) -> Arc<Fs> {
+    let blob_service = Arc::new(MemoryBlobService::default()) as Arc<dyn BlobService>;
+    let directory_service =
+        Arc::new(crate::utils::gen_test_directory_service()) as Arc<dyn DirectoryService>;
+
+    let put = async |contents: Vec<u8>| {
+        let mut w = blob_service.open_write().await;
+        tokio::io::copy(&mut Cursor::new(contents), &mut w)
+            .await
+            .unwrap();
+        let size = w.close().await.unwrap();
+        let _ = size;
+    };
+
+    put(fixtures::BLOB_A.to_vec()).await;
+    put(declaration.as_bytes().to_vec()).await;
+
+    let file = |digest, size, executable| Node::File {
+        digest,
+        size,
+        executable,
+    };
+
+    let blob_a = file(
+        *fixtures::BLOB_A_DIGEST,
+        fixtures::BLOB_A.len() as u64,
+        false,
+    );
+    let decl_digest = blake3::hash(declaration.as_bytes()).into();
+    let decl = file(decl_digest, declaration.len() as u64, false);
+
+    let mk_dir = async |name: &str, node: Node| {
+        let d = Directory::try_from_iter([(PathComponent::try_from(name).unwrap(), node)]).unwrap();
+        directory_service.put(d.clone()).await.unwrap();
+        Node::Directory {
+            digest: d.digest(),
+            size: d.size(),
+        }
+    };
+
+    let bin = mk_dir("hello", blob_a.clone()).await;
+    let share = mk_dir("doc", blob_a).await;
+    let nix_support = mk_dir("fsmeta", decl).await;
+
+    let root = Directory::try_from_iter([
+        ("bin".try_into().unwrap(), bin),
+        ("nix-support".try_into().unwrap(), nix_support),
+        ("share".try_into().unwrap(), share),
+    ])
+    .unwrap();
+    directory_service.put(root.clone()).await.unwrap();
+
+    let root_nodes = BTreeMap::from([(
+        ROOT.try_into().unwrap(),
+        Node::Directory {
+            digest: root.digest(),
+            size: root.size(),
+        },
+    )]);
+
+    let fs = SnixStoreFs::new(
+        blob_service,
+        directory_service,
+        Arc::new(root_nodes),
+        FSSettings {
+            fsmeta_path: Some("nix-support/fsmeta".parse().unwrap()),
+            ..Default::default()
+        },
+        tokio::runtime::Handle::current(),
+    );
+
+    Arc::new(match dax_cache {
+        Some(cache) => fs.with_dax_cache(cache),
+        None => fs,
+    })
+}
+
+/// Filesystem calls block on the tokio handle, so they have to run off the
+/// runtime thread, exactly as the FUSE and vhost-user daemons run them.
+async fn lookup(fs: &Arc<Fs>, path: &[&str]) -> fuse_backend_rs::api::filesystem::Entry {
+    let fs = fs.clone();
+    let path: Vec<CString> = path.iter().map(|p| CString::new(*p).unwrap()).collect();
+
+    tokio::task::spawn_blocking(move || {
+        let mut ino = ROOT_ID;
+        let mut entry = None;
+        for name in &path {
+            let e = fs
+                .lookup(&Context::default(), ino, name)
+                .expect("lookup must succeed");
+            ino = e.inode;
+            entry = Some(e);
+        }
+        entry.expect("at least one component")
+    })
+    .await
+    .unwrap()
+}
+
+fn declaring_hello() -> String {
+    format!("{ATTR_DAX} bin/hello\n")
+}
+
+/// The whole point: with a guest that decides per inode and somewhere to
+/// materialize blobs, exactly the file the tree named is marked.
+#[tokio::test]
+async fn marks_only_what_the_tree_declares() {
+    let dir = TempDir::new().unwrap();
+    let fs = mk_fs(&declaring_hello(), Some(DaxCache::new(dir.path()).unwrap())).await;
+
+    assert!(
+        KERNEL_MINOR_VERSION >= 36,
+        "per-inode DAX was introduced in FUSE 7.36"
+    );
+
+    let opts = fs
+        .init(FsOptions::INIT_EXT | FsOptions::PERFILE_DAX)
+        .unwrap();
+    assert!(opts.contains(FsOptions::INIT_EXT));
+    assert!(opts.contains(FsOptions::PERFILE_DAX));
+
+    let hello = lookup(&fs, &[ROOT, "bin", "hello"]).await;
+    let doc = lookup(&fs, &[ROOT, "share", "doc"]).await;
+
+    assert_eq!(FUSE_ATTR_DAX, hello.attr_flags & FUSE_ATTR_DAX);
+    assert_eq!(0, doc.attr_flags & FUSE_ATTR_DAX);
+
+    // Same blob, different declarations, so they must not share an inode --
+    // otherwise the mark would apply to whichever was looked up first.
+    assert_ne!(hello.inode, doc.inode);
+
+    // Directories have no contents to map, whatever is declared.
+    assert_eq!(0, lookup(&fs, &[ROOT]).await.attr_flags & FUSE_ATTR_DAX);
+}
+
+/// Looking the unmarked one up first must not change the answer for either.
+#[tokio::test]
+async fn marking_does_not_depend_on_lookup_order() {
+    let dir = TempDir::new().unwrap();
+    let fs = mk_fs(&declaring_hello(), Some(DaxCache::new(dir.path()).unwrap())).await;
+    fs.init(FsOptions::PERFILE_DAX).unwrap();
+
+    assert_eq!(
+        0,
+        lookup(&fs, &[ROOT, "share", "doc"]).await.attr_flags & FUSE_ATTR_DAX
+    );
+    assert_eq!(
+        FUSE_ATTR_DAX,
+        lookup(&fs, &[ROOT, "bin", "hello"]).await.attr_flags & FUSE_ATTR_DAX
+    );
+    assert_eq!(
+        0,
+        lookup(&fs, &[ROOT, "share", "doc"]).await.attr_flags & FUSE_ATTR_DAX
+    );
+}
+
+/// A tree that declares nothing behaves exactly as it did before any of this,
+/// including sharing one inode between two names for one blob.
+#[tokio::test]
+async fn a_tree_declaring_nothing_is_unaffected() {
+    let dir = TempDir::new().unwrap();
+    let fs = mk_fs("# nothing\n", Some(DaxCache::new(dir.path()).unwrap())).await;
+    fs.init(FsOptions::PERFILE_DAX).unwrap();
+
+    let hello = lookup(&fs, &[ROOT, "bin", "hello"]).await;
+    let doc = lookup(&fs, &[ROOT, "share", "doc"]).await;
+
+    assert_eq!(0, hello.attr_flags & FUSE_ATTR_DAX);
+    assert_eq!(0, doc.attr_flags & FUSE_ATTR_DAX);
+    assert_eq!(
+        hello.inode, doc.inode,
+        "sharing must be as aggressive as before"
+    );
+}
+
+/// A guest that never offered to decide per inode gets no marks.
+#[tokio::test]
+async fn without_guest_support_nothing_is_marked() {
+    let dir = TempDir::new().unwrap();
+    let fs = mk_fs(&declaring_hello(), Some(DaxCache::new(dir.path()).unwrap())).await;
+
+    assert!(
+        !fs.init(FsOptions::empty())
+            .unwrap()
+            .contains(FsOptions::PERFILE_DAX)
+    );
+    assert_eq!(
+        0,
+        lookup(&fs, &[ROOT, "bin", "hello"]).await.attr_flags & FUSE_ATTR_DAX
+    );
+}
+
+/// Without a cache there is nothing to map, so per-inode DAX is declined
+/// outright rather than promising something setupmapping would then refuse.
+#[tokio::test]
+async fn without_a_cache_perfile_dax_is_declined() {
+    let fs = mk_fs(&declaring_hello(), None).await;
+
+    assert!(
+        !fs.init(FsOptions::PERFILE_DAX)
+            .unwrap()
+            .contains(FsOptions::PERFILE_DAX)
+    );
+    assert_eq!(
+        0,
+        lookup(&fs, &[ROOT, "bin", "hello"]).await.attr_flags & FUSE_ATTR_DAX
+    );
+}
