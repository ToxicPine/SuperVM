@@ -494,7 +507,41 @@ where
     /// communicated here, which is why this exists rather than callers reaching
     /// for [attr_to_fuse_entry] directly.
     fn inode_data_to_fuse_entry(&self, inode_data: &InodeData, ino: u64) -> Entry {
-        attr_to_fuse_entry(self.inode_data_to_attr(inode_data, ino))
+        let mut entry = attr_to_fuse_entry(self.inode_data_to_attr(inode_data, ino));
+
+        #[cfg(all(feature = "virtiofs", target_os = "linux"))]
+        if self.dax_eligible(inode_data) {
+            entry.attr_flags |= fuse_backend_rs::abi::fuse_abi::FUSE_ATTR_DAX;
+            debug!(ino, "marking inode to be mapped rather than read");
+        }
+
+        entry
+    }
+
+    /// Whether the guest should map this inode rather than read it.
+    ///
+    /// Four things have to hold, and all of them can independently be false on
+    /// a working system, which is why every one of them falls back to ordinary
+    /// reads rather than to an error:
+    ///
+    /// - the guest agreed to decide this per inode;
+    /// - we have somewhere to materialize blobs, so a mapping can be answered
+    ///   at all;
+    /// - the node is a regular file, the only thing with contents to map;
+    /// - the tree asked for this file to be mapped.
+    ///
+    /// The last of those defaults to not mapping, which is the polarity of the
+    /// primitive underneath: `FUSE_ATTR_DAX` is a bit the filesystem sets, and
+    /// an inode whose lookup reply leaves it clear is not mapped. A tree that
+    /// says nothing gets what it would have got before any of this existed.
+    #[cfg(all(feature = "virtiofs", target_os = "linux"))]
+    fn dax_eligible(&self, inode_data: &InodeData) -> bool {
+        use std::sync::atomic::Ordering;
+
+        self.perfile_dax.load(Ordering::Relaxed)
+            && self.dax_cache.is_some()
+            && matches!(inode_data, InodeData::Regular(..))
+            && inode_data.attrs().attrs().dax
     }
 }
 fn attr_to_fuse_entry(attr: Attr) -> Entry {
