         // TODO: figure out what dawrin options make sense.
 
+        // Decide DAX per inode rather than for the whole mount, when the guest
+        // offers to and we can actually answer a mapping. Guests which do not
+        // offer it keep whatever their mount options said, and read normally.
+        #[cfg(all(feature = "virtiofs", target_os = "linux"))]
+        if capable.contains(FsOptions::PERFILE_DAX) && self.dax_cache.is_some() {
+            // PERFILE_DAX lives in flags2. INIT_EXT tells the kernel that the
+            // flags2 word in our reply is valid; without echoing it the kernel
+            // silently ignores the negotiated capability and every inode
+            // falls back to ordinary reads.
+            opts |= FsOptions::INIT_EXT | FsOptions::PERFILE_DAX;
+            self.perfile_dax
+                .store(true, std::sync::atomic::Ordering::Relaxed);
+        }
+
+        let _ = capable;
+
         Ok(opts)
     }
 
