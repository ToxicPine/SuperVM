From: SuperVM contributors <supervm@localhost>
Subject: [PATCH] virtiofs: populate and release DAX memmaps on demand

Allocate page metadata only for chunks containing assigned FUSE ranges.
Tie population and release to mapping lifetime, draining layout pins
before removal, and allocate range descriptors on demand. Keep capacity
queries allocation-free and expose current population through sysfs.

---
diff --git a/drivers/dax/super.c b/drivers/dax/super.c
index 25cf99d..794e147 100644
--- a/drivers/dax/super.c
+++ b/drivers/dax/super.c
@@ -235,6 +235,37 @@ long dax_direct_access(struct dax_device *dax_dev, pgoff_t pgoff, long nr_pages,
 }
 EXPORT_SYMBOL_GPL(dax_direct_access);
 
+/* Caller already holds a live reference while acquiring another owner. */
+void get_dax(struct dax_device *dax_dev)
+{
+	ihold(&dax_dev->inode);
+}
+EXPORT_SYMBOL_GPL(get_dax);
+
+/* Take SRCU internally: a driver can tear down its memmaps after kill_dax(). */
+int dax_get_range(struct dax_device *dax_dev, u64 offset, u64 len)
+{
+	int id = dax_read_lock();
+	int ret = -ENXIO;
+
+	if (dax_alive(dax_dev))
+		ret = dax_dev->ops->get_range ?
+			dax_dev->ops->get_range(dax_dev, offset, len) : 0;
+	dax_read_unlock(id);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(dax_get_range);
+
+void dax_put_range(struct dax_device *dax_dev, u64 offset, u64 len)
+{
+	int id = dax_read_lock();
+
+	if (dax_alive(dax_dev) && dax_dev->ops->put_range)
+		dax_dev->ops->put_range(dax_dev, offset, len);
+	dax_read_unlock(id);
+}
+EXPORT_SYMBOL_GPL(dax_put_range);
+
 size_t dax_copy_from_iter(struct dax_device *dax_dev, pgoff_t pgoff, void *addr,
 		size_t bytes, struct iov_iter *i)
 {
