diff --git a/fs/fuse/virtio_fs.c b/fs/fuse/virtio_fs.c
index 1230065..31fe11b 100644
--- a/fs/fuse/virtio_fs.c
+++ b/fs/fuse/virtio_fs.c
@@ -19,6 +19,8 @@
 #include <linux/highmem.h>
 #include <linux/cleanup.h>
 #include <linux/uio.h>
+#include <linux/sched/mm.h>
+#include <linux/sizes.h>
 #include "fuse_i.h"
 #include "fuse_dev_i.h"
 
@@ -73,10 +75,32 @@ struct virtio_fs {
 
 	unsigned int *mq_map; /* index = cpu id, value = request vq id */
 
-	/* DAX memory window where file contents are mapped */
-	void *window_kaddr;
-	phys_addr_t window_phys_addr;
-	size_t window_len;
+};
+
+/* Keep small-file memmaps bounded without hotplugging every 64 KiB range. */
+#ifdef CONFIG_FUSE_DAX
+#define VIRTIO_FS_DAX_CHUNK_SHIFT max_t(unsigned int, 24, CONFIG_FUSE_DAX_SHIFT)
+#else
+#define VIRTIO_FS_DAX_CHUNK_SHIFT 24
+#endif
+
+struct virtio_fs_dax_chunk {
+	struct dev_pagemap pgmap;
+	void *kaddr;
+	unsigned long users;
+};
+
+/* Owned by dax_dev, independently of the virtio_fs kobject and connection. */
+struct virtio_fs_dax {
+	struct mutex lock;
+	struct xarray chunks;
+	phys_addr_t phys;
+	u64 len;
+	int nid;
+	u64 mapped_bytes;
+	u64 active_ranges;
+	u64 map_events;
+	u64 unmap_events;
 };
 
 struct virtio_fs_forget_req {
@@ -180,10 +204,41 @@ static ssize_t tag_show(struct kobject *kobj,
 	return sysfs_emit(buf, "%s\n", fs->tag);
 }
 
+/* A single snapshot keeps growth/release tests independent of debug logs. */
+static ssize_t dax_memmap_show(struct kobject *kobj,
+		struct kobj_attribute *attr, char *buf)
+{
+	struct virtio_fs *fs = container_of(kobj, struct virtio_fs, kobj);
+	struct virtio_fs_dax *dax;
+	ssize_t ret;
+	int id;
+
+	if (!fs->dax_dev)
+		return -ENODEV;
+	id = dax_read_lock();
+	dax = dax_get_private(fs->dax_dev);
+	if (!dax) {
+		ret = -ENODEV;
+		goto out;
+	}
+	mutex_lock(&dax->lock);
+	ret = sysfs_emit(buf,
+		"window_bytes %llu\nchunk_bytes %llu\nmapped_bytes %llu\n"
+		"active_ranges %llu\nmap_events %llu\nunmap_events %llu\n",
+		dax->len, 1ULL << VIRTIO_FS_DAX_CHUNK_SHIFT, dax->mapped_bytes,
+		dax->active_ranges, dax->map_events, dax->unmap_events);
+	mutex_unlock(&dax->lock);
+out:
+	dax_read_unlock(id);
+	return ret;
+}
+
+static struct kobj_attribute virtio_fs_dax_memmap_attr = __ATTR_RO(dax_memmap);
 static struct kobj_attribute virtio_fs_tag_attr = __ATTR_RO(tag);
 
 static struct attribute *virtio_fs_attrs[] = {
 	&virtio_fs_tag_attr.attr,
+	&virtio_fs_dax_memmap_attr.attr,
 	NULL
 };
 ATTRIBUTE_GROUPS(virtio_fs);
@@ -1024,19 +1079,142 @@ static void virtio_fs_cleanup_vqs(struct virtio_device *vdev)
  * been produced by .iomap_begin(), which maps a file offset to a window
  * offset.
  */
+#ifdef CONFIG_FUSE_DAX
+/* offset/len must describe one range entirely inside a chunk and window. */
+static bool virtio_fs_dax_valid_range(struct virtio_fs_dax *dax,
+				    u64 offset, u64 len)
+{
+	return len && IS_ALIGNED(offset, PAGE_SIZE) &&
+		IS_ALIGNED(len, PAGE_SIZE) && offset < dax->len &&
+		len <= dax->len - offset &&
+		(offset >> VIRTIO_FS_DAX_CHUNK_SHIFT) ==
+		((offset + len - 1) >> VIRTIO_FS_DAX_CHUNK_SHIFT);
+}
+
+static int virtio_fs_dax_get_range(struct dax_device *dax_dev, u64 offset, u64 len)
+{
+	struct virtio_fs_dax *dax = dax_get_private(dax_dev);
+	unsigned long index = offset >> VIRTIO_FS_DAX_CHUNK_SHIFT;
+	u64 start = (u64)index << VIRTIO_FS_DAX_CHUNK_SHIFT;
+	u64 size;
+	struct virtio_fs_dax_chunk *chunk;
+	unsigned int nofs;
+	int ret = 0;
+
+	/* kill_dax() can clear ALIVE after the core's initial liveness check. */
+	if (!dax)
+		return -ENXIO;
+	if (!virtio_fs_dax_valid_range(dax, offset, len))
+		return -EINVAL;
+	size = min(1ULL << VIRTIO_FS_DAX_CHUNK_SHIFT, dax->len - start);
+
+	/* memremap_pages() allocates with GFP_KERNEL under filesystem locks. */
+	nofs = memalloc_nofs_save();
+	mutex_lock(&dax->lock);
+	chunk = xa_load(&dax->chunks, index);
+	if (chunk)
+		goto got_chunk;
+
+	chunk = kzalloc_obj(*chunk);
+	if (!chunk) {
+		ret = -ENOMEM;
+		goto out;
+	}
+	chunk->pgmap.type = MEMORY_DEVICE_FS_DAX;
+	chunk->pgmap.range.start = dax->phys + start;
+	chunk->pgmap.range.end = dax->phys + start + size - 1;
+	chunk->pgmap.nr_range = 1;
+	chunk->kaddr = memremap_pages(&chunk->pgmap, dax->nid);
+	if (IS_ERR(chunk->kaddr)) {
+		ret = PTR_ERR(chunk->kaddr);
+		kfree(chunk);
+		goto out;
+	}
+	ret = xa_err(xa_store(&dax->chunks, index, chunk, GFP_KERNEL));
+	if (ret) {
+		memunmap_pages(&chunk->pgmap);
+		kfree(chunk);
+		goto out;
+	}
+	dax->mapped_bytes += size;
+	dax->map_events++;
+got_chunk:
+	chunk->users++;
+	dax->active_ranges++;
+out:
+	mutex_unlock(&dax->lock);
+	memalloc_nofs_restore(nofs);
+	return ret;
+}
+
+static void virtio_fs_dax_put_range(struct dax_device *dax_dev, u64 offset, u64 len)
+{
+	struct virtio_fs_dax *dax = dax_get_private(dax_dev);
+	unsigned long index = offset >> VIRTIO_FS_DAX_CHUNK_SHIFT;
+	struct virtio_fs_dax_chunk *chunk;
+
+	/* Teardown releases all remaining chunks after the SRCU grace period. */
+	if (!dax)
+		return;
+	if (WARN_ON_ONCE(!virtio_fs_dax_valid_range(dax, offset, len)))
+		return;
+	mutex_lock(&dax->lock);
+	chunk = xa_load(&dax->chunks, index);
+	if (WARN_ON_ONCE(!chunk || !chunk->users))
+		goto out;
+	dax->active_ranges--;
+	if (--chunk->users)
+		goto out;
+
+	/*
+	 * FUSE has invalidated all entries and drained layout pins before
+	 * releasing the last range. Serialize hot-remove with the next get;
+	 * the ID is not reusable until this returns. No direct_access user
+	 * can still hold an iomap for this chunk.
+	 */
+	xa_erase(&dax->chunks, index);
+	memunmap_pages(&chunk->pgmap);
+	dax->mapped_bytes -= range_len(&chunk->pgmap.range);
+	dax->unmap_events++;
+	kfree(chunk);
+out:
+	mutex_unlock(&dax->lock);
+}
+
 static long virtio_fs_direct_access(struct dax_device *dax_dev, pgoff_t pgoff,
 				    long nr_pages, enum dax_access_mode mode,
 				    void **kaddr, unsigned long *pfn)
 {
-	struct virtio_fs *fs = dax_get_private(dax_dev);
-	phys_addr_t offset = PFN_PHYS(pgoff);
-	size_t max_nr_pages = fs->window_len / PAGE_SIZE - pgoff;
-
+	struct virtio_fs_dax *dax = dax_get_private(dax_dev);
+	struct virtio_fs_dax_chunk *chunk;
+	u64 offset = PFN_PHYS(pgoff);
+	unsigned long index = offset >> VIRTIO_FS_DAX_CHUNK_SHIFT;
+	u64 start = (u64)index << VIRTIO_FS_DAX_CHUNK_SHIFT;
+	long avail;
+
+	if (!dax)
+		return -ENXIO;
+	if (pgoff >= dax->len >> PAGE_SHIFT)
+		return -ERANGE;
+	/* FUSE's capacity query must not populate any metadata. */
+	if (!kaddr && !pfn)
+		return min_t(u64, nr_pages, (dax->len >> PAGE_SHIFT) - pgoff);
+
+	mutex_lock(&dax->lock);
+	chunk = xa_load(&dax->chunks, index);
+	if (!chunk) {
+		avail = -ENXIO;
+		goto out;
+	}
+	avail = min_t(u64, nr_pages,
+		(range_len(&chunk->pgmap.range) - (offset - start)) >> PAGE_SHIFT);
 	if (kaddr)
-		*kaddr = fs->window_kaddr + offset;
+		*kaddr = chunk->kaddr + offset - start;
 	if (pfn)
-		*pfn = PHYS_PFN(fs->window_phys_addr + offset);
-	return nr_pages > max_nr_pages ? max_nr_pages : nr_pages;
+		*pfn = PHYS_PFN(dax->phys + offset);
+out:
+	mutex_unlock(&dax->lock);
+	return avail;
 }
 
 static int virtio_fs_zero_page_range(struct dax_device *dax_dev,
@@ -1057,84 +1235,84 @@ static int virtio_fs_zero_page_range(struct dax_device *dax_dev,
 
