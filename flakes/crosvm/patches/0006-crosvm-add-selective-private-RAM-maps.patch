+        let ranges = valid_map().validate_and_normalize().unwrap();
+        assert_eq!(ranges[0].guest_physical_start, 0);
+        assert_eq!(
+            ranges[1].guest_physical_start,
+            (base::pagesize() * 2) as u64
+        );
+    }
+
+    #[test]
