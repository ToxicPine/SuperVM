new file mode 100644
index 000000000..59c741152
--- /dev/null
+++ b/src/crosvm/sys/linux/private_ram.rs
@@ -0,0 +1,357 @@
+// Copyright 2026 The ChromiumOS Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+//! Validation and layout application for private guest RAM maps.
+//!
+//! The input is a versioned JSON object. `pageSize` is the host page size expected by the
+//! producer; ranges use absolute guest-physical addresses and must be aligned to that size:
+//! ```text
+//! {
+//!   "schemaVersion": 1,
+//!   "pageSize": 4096,
+//!   "ranges": [
+//!     { "guestPhysicalStart": 16777216, "length": 2097152 }
+//!   ]
+//! }
+//! ```
+//! Unknown object fields are accepted so producers can attach metadata without changing the
+//! consumer schema.
+
+use std::fs::File;
+use std::io::BufReader;
+use std::path::Path;
+
+use anyhow::bail;
+use anyhow::Context;
+use anyhow::Result;
+use serde::Deserialize;
+use vm_memory::GuestAddress;
+use vm_memory::MemoryRegionOptions;
+use vm_memory::MemoryRegionPurpose;
+use vm_memory::RamBacking;
+
+const SUPPORTED_SCHEMA_VERSION: u32 = 1;
+
+#[derive(Clone, Debug, Deserialize, PartialEq, Eq)]
+#[serde(rename_all = "camelCase")]
+pub(super) struct PrivateRamRange {
+    pub(super) guest_physical_start: u64,
+    pub(super) length: u64,
+}
+
+impl PrivateRamRange {
+    fn end(&self) -> Result<u64> {
+        self.guest_physical_start
+            .checked_add(self.length)
+            .with_context(|| {
+                format!(
+                    "private RAM range at {:#x} overflows",
+                    self.guest_physical_start
+                )
+            })
+    }
+}
+
+#[derive(Debug, Deserialize)]
+#[serde(rename_all = "camelCase")]
+struct PrivateRamMap {
+    page_size: u64,
+    ranges: Vec<PrivateRamRange>,
+    schema_version: u32,
+}
+
+impl PrivateRamMap {
+    fn validate_and_normalize(mut self) -> Result<Vec<PrivateRamRange>> {
+        if self.schema_version != SUPPORTED_SCHEMA_VERSION {
+            bail!(
+                "unsupported private RAM map schema version {}; expected {}",
+                self.schema_version,
+                SUPPORTED_SCHEMA_VERSION
+            );
+        }
+        let host_page_size = base::pagesize() as u64;
+        if self.page_size != host_page_size {
+            bail!(
+                "private RAM map page size {} does not match host page size {}",
+                self.page_size,
+                host_page_size
+            );
+        }
+        if self.ranges.is_empty() {
+            bail!("private RAM map contains no ranges");
+        }
+
+        self.ranges.sort_by_key(|range| range.guest_physical_start);
+        let mut previous_end = 0;
+        let mut normalized = Vec::<PrivateRamRange>::with_capacity(self.ranges.len());
+        for range in self.ranges {
+            if range.length == 0 {
+                bail!(
+                    "private RAM range at {:#x} is empty",
+                    range.guest_physical_start
+                );
+            }
+            if range.guest_physical_start % self.page_size != 0
+                || range.length % self.page_size != 0
+            {
+                bail!(
+                    "private RAM range at {:#x} with length {:#x} is not page aligned",
+                    range.guest_physical_start,
+                    range.length
+                );
+            }
+            let end = range.end()?;
+            if range.guest_physical_start < previous_end {
+                bail!(
+                    "private RAM range at {:#x} overlaps a previous range",
+                    range.guest_physical_start
+                );
+            }
+            previous_end = end;
+
+            if let Some(previous) = normalized.last_mut() {
+                if previous.end()? == range.guest_physical_start {
+                    previous.length = previous
+                        .length
+                        .checked_add(range.length)
+                        .context("adjacent private RAM ranges overflow")?;
+                    continue;
+                }
+            }
+
+            normalized.push(range);
+        }
+
+        Ok(normalized)
+    }
+}
+
+pub(super) fn load(path: &Path) -> Result<Vec<PrivateRamRange>> {
+    let file = File::open(path)
+        .with_context(|| format!("failed to open private RAM map {}", path.display()))?;
+    let map: PrivateRamMap = serde_json::from_reader(BufReader::new(file))
+        .with_context(|| format!("failed to parse private RAM map {}", path.display()))?;
+    map.validate_and_normalize()
+}
+
+/// Splits an architecture-provided layout so that exactly `private_ranges`
+/// receive private anonymous backing.
+pub(super) fn apply_to_layout(
+    mut layout: Vec<(GuestAddress, u64, MemoryRegionOptions)>,
+    private_ranges: &[PrivateRamRange],
+) -> Result<Vec<(GuestAddress, u64, MemoryRegionOptions)>> {
+    for private_range in private_ranges {
+        let private_start = private_range.guest_physical_start;
+        let private_end = private_range.end()?;
+        let index = layout
+            .iter()
+            .position(|(start, length, _)| {
+                start.0 <= private_start
+                    && start
+                        .0
+                        .checked_add(*length)
+                        .is_some_and(|end| private_end <= end)
+            })
+            .with_context(|| {
+                format!(
+                    "private RAM range {private_start:#x}..{private_end:#x} is outside a single \
+                     guest RAM region"
+                )
+            })?;
+
+        let (region_start, region_length, options) = layout.remove(index);
+        let region_end = region_start
+            .0
+            .checked_add(region_length)
+            .context("guest RAM region overflows")?;
+        if options.purpose != MemoryRegionPurpose::GuestMemoryRegion {
+            bail!(
+                "private RAM range at {private_start:#x} targets a {:?} region",
+                options.purpose
+            );
+        }
+        if options.file_backed.is_some() {
+            bail!("private RAM range at {private_start:#x} targets file-backed RAM");
+        }
+        if options.ram_backing != RamBacking::Shared {
+            bail!("private RAM range at {private_start:#x} targets non-shared RAM");
+        }
+
+        let mut replacements = Vec::with_capacity(3);
+        if region_start.0 < private_start {
+            replacements.push((
+                region_start,
+                private_start - region_start.0,
+                options.clone(),
+            ));
+        }
+        replacements.push((
+            GuestAddress(private_start),
+            private_range.length,
+            options.clone().ram_backing(RamBacking::PrivateAnonymous),
+        ));
+        if private_end < region_end {
+            replacements.push((GuestAddress(private_end), region_end - private_end, options));
+        }
+        layout.splice(index..index, replacements);
+    }
+
+    Ok(layout)
+}
+
