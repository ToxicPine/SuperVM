+        );
+        let map: PrivateRamMap = serde_json::from_str(&document).unwrap();
+        assert_eq!(map.validate_and_normalize().unwrap().len(), 1);
+    }
+
+    #[test]
+    fn overlapping_ranges_are_rejected() {
+        let page_size = base::pagesize() as u64;
+        let mut map = valid_map();
+        map.ranges[0].guest_physical_start = 0;
+        map.ranges[0].length = page_size * 2;
+        assert!(map.validate_and_normalize().is_err());
+    }
+
+    #[test]
+    fn unsupported_schema_version_is_rejected() {
+        let mut map = valid_map();
+        map.schema_version = SUPPORTED_SCHEMA_VERSION + 1;
+        assert!(map.validate_and_normalize().is_err());
+    }
+
+    #[test]
+    fn adjacent_ranges_are_coalesced() {
+        let page_size = base::pagesize() as u64;
+        let mut map = valid_map();
+        map.ranges[0].guest_physical_start = page_size;
+        let ranges = map.validate_and_normalize().unwrap();
+
+        assert_eq!(
+            ranges,
+            vec![PrivateRamRange {
+                guest_physical_start: 0,
+                length: page_size * 2,
+            }]
+        );
+    }
+
+    #[test]
+    fn empty_and_unaligned_ranges_are_rejected() {
+        let page_size = base::pagesize() as u64;
+        let mut empty = valid_map();
+        empty.ranges[0].length = 0;
+        assert!(empty.validate_and_normalize().is_err());
+
+        let mut unaligned = valid_map();
+        unaligned.ranges[0].guest_physical_start += 1;
+        assert!(unaligned.validate_and_normalize().is_err());
+
+        let mut wrong_page_size = valid_map();
+        wrong_page_size.page_size = page_size * 2;
+        assert!(wrong_page_size.validate_and_normalize().is_err());
+    }
+
+    #[test]
+    fn layout_is_split_around_private_ranges() {
+        let page_size = base::pagesize() as u64;
+        let ranges = valid_map().validate_and_normalize().unwrap();
+        let layout = vec![(GuestAddress(0), page_size * 4, MemoryRegionOptions::new())];
+        let result = apply_to_layout(layout, &ranges).unwrap();
+
+        assert_eq!(result.len(), 4);
+        assert_eq!(result[0].2.ram_backing, RamBacking::PrivateAnonymous);
+        assert_eq!(result[1].2.ram_backing, RamBacking::Shared);
+        assert_eq!(result[2].2.ram_backing, RamBacking::PrivateAnonymous);
+        assert_eq!(result[3].2.ram_backing, RamBacking::Shared);
+
+        let guest_memory = vm_memory::GuestMemory::new_with_options(&result).unwrap();
+        let is_private: Vec<_> = guest_memory
+            .regions()
+            .map(|region| matches!(region.backing, vm_memory::BackingObject::PrivateAnonymous))
+            .collect();
+        assert_eq!(is_private, [true, false, true, false]);
+    }
+
+    #[test]
+    fn range_crossing_a_layout_boundary_is_rejected() {
+        let page_size = base::pagesize() as u64;
+        let range = PrivateRamRange {
+            guest_physical_start: page_size,
+            length: page_size * 2,
+        };
+        let layout = vec![
+            (GuestAddress(0), page_size * 2, MemoryRegionOptions::new()),
+            (
+                GuestAddress(page_size * 2),
+                page_size * 2,
+                MemoryRegionOptions::new(),
+            ),
+        ];
+
+        assert!(apply_to_layout(layout, &[range]).is_err());
+    }
+
+    #[test]
+    fn reserved_memory_cannot_be_made_private() {
+        let page_size = base::pagesize() as u64;
+        let range = PrivateRamRange {
+            guest_physical_start: 0,
+            length: page_size,
+        };
+        let layout = vec![(
+            GuestAddress(0),
+            page_size,
+            MemoryRegionOptions::new().purpose(MemoryRegionPurpose::ReservedMemory),
+        )];
+
+        assert!(apply_to_layout(layout, &[range]).is_err());
+    }
+}
