+
+    fn valid_map() -> PrivateRamMap {
+        let page_size = base::pagesize() as u64;
+        PrivateRamMap {
+            page_size,
+            ranges: vec![
+                PrivateRamRange {
+                    guest_physical_start: page_size * 2,
+                    length: page_size,
+                },
+                PrivateRamRange {
+                    guest_physical_start: 0,
+                    length: page_size,
+                },
+            ],
+            schema_version: SUPPORTED_SCHEMA_VERSION,
+        }
+    }
+
