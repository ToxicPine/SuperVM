+    #[test]
+    fn load_image_across_adjacent_memory_regions() {
+        let mem =
+            GuestMemory::new(&[(GuestAddress(0), 0x1000), (GuestAddress(0x1000), 0x1000)]).unwrap();
+        let expected = vec![0x5a; 0x1000];
+        let mut image = tempfile().unwrap();
+        image.write_all(&expected).unwrap();
+        image.seek(SeekFrom::Start(0)).unwrap();
