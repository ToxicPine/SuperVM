+
+    /// Returns volatile slices covering `len` bytes starting at `addr`.
+    ///
+    /// Unlike [`GuestMemory::get_slice_at_addr`], this method can span adjacent guest memory
+    /// regions. The slices are contiguous in guest address space but may be unrelated in host
+    /// address space. It returns an error if any part of the requested range is not backed by
+    /// guest memory.
+    ///
+    /// A zero-length request validates `addr` and returns an empty vector.
+    pub fn get_spanning_slices_at_addr(
+        &self,
+        addr: GuestAddress,
+        len: usize,
+    ) -> Result<Vec<VolatileSlice<'_>>> {
+        if len == 0 {
+            self.get_slice_at_addr(addr, 0)?;
+            return Ok(Vec::new());
+        }
+
+        let mut slices = Vec::new();
+        let mut current = addr;
+        let mut remaining = len;
+
+        while remaining != 0 {
+            let region = self
+                .regions
+                .iter()
+                .find(|region| region.contains(current))
+                .ok_or(Error::InvalidGuestAddress(current))?;
+            let offset = usize::try_from(current.offset_from(region.start()))
+                .map_err(|_| Error::InvalidGuestAddress(current))?;
+            // `region.contains(current)` guarantees that `offset` is within the mapping.
+            let size = remaining.min(region.mapping.size() - offset);
+            slices.push(
+                region
+                    .mapping
+                    .get_slice(offset, size)
+                    .map_err(Error::VolatileMemoryAccess)?,
+            );
+            remaining -= size;
+            if remaining != 0 {
+                current = current
+                    .checked_add(size as u64)
+                    .ok_or(Error::InvalidGuestAddress(current))?;
+            }
+        }
+
+        Ok(slices)
+    }
