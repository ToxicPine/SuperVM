+    /// Reads bytes from this file at `offset` to fill each destination slice in order.
+    fn read_exact_vectored_at_volatile(
+        &self,
+        slices: &[VolatileSlice],
+        mut offset: u64,
+    ) -> Result<()> {
+        let mut slices = slices
+            .iter()
+            .copied()
+            .filter(|slice| slice.size() != 0)
+            .peekable();
+        while let Some(slice) = slices.next() {
+            self.read_exact_at_volatile(slice, offset)?;
+            if slices.peek().is_some() {
+                offset = offset
+                    .checked_add(slice.size() as u64)
+                    .ok_or_else(|| Error::from(ErrorKind::InvalidInput))?;
+            }
+        }
+        Ok(())
+    }
