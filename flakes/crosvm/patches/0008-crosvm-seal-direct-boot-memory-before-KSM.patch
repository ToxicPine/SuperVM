@@ -0,0 +1,122 @@
+// Copyright 2026 The ChromiumOS Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+//! One-way direct Linux boot protocol: writable/unmerged -> sealed/mergeable.
+//! Port 0x5050 lies outside PCI I/O allocation (0xc000..0xffff); bus insertion
+//! rejects collisions with fixed devices.
+//! A compatible kernel requests sealing after mark_readonly(), before userspace.
+use std::sync::Arc;
+
+use anyhow::Context;
+use arch::RunnableLinuxVm;
+use base::{error, info, Tube};
+use devices::{BusAccessInfo, BusDevice, Suspendable};
+use hypervisor::{VmArch, VmCap};
+use sync::Mutex;
+use vm_control::{DeviceId, PlatformDeviceId, VmRequest};
+use vm_memory::BackingObject;
+
+const PORT: u64 = 0x5050;
+const REQUEST: u32 = 0x5345414c;
+const READY: u32 = 0x53564d01;
+const SEALED: u32 = 0x53564d02;
+const PENDING: u32 = 0x53564d03;
+
+struct BootMemory {
+    vm: Arc<dyn VmArch>,
+    requested: bool,
+    control: Tube,
+}
+
+fn violation(message: &str) -> ! {
+    error!("boot memory protection violation: {}", message);
+    // Continuing after a partial seal or an attempted protected write is unsafe.
+    std::process::exit(1)
+}
+
+impl BusDevice for BootMemory {
+    fn device_id(&self) -> DeviceId {
+        PlatformDeviceId::BootMemory.into()
+    }
+    fn debug_label(&self) -> String {
+        "boot-memory-seal".into()
+    }
+    fn read(&mut self, access: BusAccessInfo, data: &mut [u8]) {
+        if access.offset != 0 || data.len() != 4 {
+            violation("invalid status read");
+        }
+        let status = if self.vm.boot_memory_sealed() {
+            SEALED
+        } else if self.requested {
+            PENDING
+        } else {
+            READY
+        };
+        data.copy_from_slice(&status.to_le_bytes());
+    }
+    fn write(&mut self, access: BusAccessInfo, data: &[u8]) {
+        if access.offset != 0 || data != REQUEST.to_le_bytes() || self.requested {
+            violation("invalid or repeated seal request");
+        }
+        self.requested = true;
+        info!("boot-memory state=sealing");
+        // Do not block this vCPU waiting for a reply: the main loop must suspend it.
+        if let Err(e) = self.control.send(&VmRequest::SealBootMemory) {
+            violation(&format!("cannot request seal: {e}"));
+        }
+    }
+}
+impl Suspendable for BootMemory {}
+
+struct ProtectedBootMemory;
+impl BusDevice for ProtectedBootMemory {
+    fn device_id(&self) -> DeviceId {
+        PlatformDeviceId::BootMemory.into()
+    }
+    fn debug_label(&self) -> String {
+        "protected-boot-memory".into()
+    }
+    fn write(&mut self, access: BusAccessInfo, _data: &[u8]) {
+        violation(&format!("guest write to {:#x}", access.address));
+    }
+    fn read(&mut self, _access: BusAccessInfo, _data: &mut [u8]) {
+        violation("unexpected MMIO read from boot RAM");
+    }
+}
+impl Suspendable for ProtectedBootMemory {}
+
+pub fn install(linux: &mut RunnableLinuxVm) -> anyhow::Result<()> {
+    anyhow::ensure!(
+        linux.vm.check_capability(VmCap::ReadOnlyMemoryRegion),
+        "boot memory sealing requires KVM read-only memory"
+    );
+    info!("boot-memory state=initializing (writable, not KSM-eligible)");
+    let (control, host) = Tube::pair()?;
+    linux.vm_request_tubes.push(host);
+    linux
+        .io_bus
+        .insert(
+            Arc::new(Mutex::new(BootMemory {
+                vm: linux.vm.clone(),
+                requested: false,
+                control,
+            })),
+            PORT,
+            4,
+        )
+        .context("reserve boot memory handshake port")?;
+    for region in linux.vm.get_memory().regions() {
+        if matches!(region.backing, BackingObject::PrivateAnonymous) {
+            linux
+                .mmio_bus
+                .insert(
+                    Arc::new(Mutex::new(ProtectedBootMemory)),
+                    region.guest_addr.offset(),
+                    region.size as u64,
+                )
+                .context("install protected RAM write trap")?;
+        }
+    }
+    Ok(())
+}
