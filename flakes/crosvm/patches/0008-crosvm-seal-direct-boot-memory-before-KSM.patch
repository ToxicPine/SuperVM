+            boot_sealed: std::sync::atomic::AtomicBool::new(false),
         };
         vm.caps.kvmclock_ctrl = vm.check_raw_capability(KvmCap::KvmclockCtrl);
         vm.caps.user_noncoherent_dma = vm.check_raw_capability(KvmCap::MemNoncoherentDma);
@@ -663,6 +665,61 @@ impl Vm for KvmVm {
         &self.guest_mem
     }
 
+    fn boot_memory_sealed(&self) -> bool {
+        self.boot_sealed.load(std::sync::atomic::Ordering::Acquire)
+    }
+
+    fn seal_boot_memory(&self) -> anyhow::Result<()> {
+        anyhow::ensure!(!self.boot_memory_sealed(), "boot memory is already sealed");
+        anyhow::ensure!(
+            self.check_capability(VmCap::ReadOnlyMemoryRegion),
+            "KVM read-only memory is unavailable"
+        );
+        // These are the original, separately registered RAM slots. All guest CPU
+        // mappings must become read-only before any host mapping becomes mergeable.
+        for region in self.guest_mem.regions() {
+            if !matches!(region.backing, vm_memory::BackingObject::PrivateAnonymous) {
+                continue;
+            }
+            // SAFETY: all vCPUs are stopped by the caller. KVM requires deleting a
+            // slot before changing READONLY. Preserve its address, size and backing;
+            // a failure must terminate the VM without resuming any vCPU.
+            unsafe {
+                set_user_memory_region(
+                    self,
+                    region.index as MemSlot,
+                    false,
+                    false,
+                    MemCacheType::CacheCoherent,
+                    0,
+                    0,
+                    std::ptr::null_mut(),
+                )?;
+                set_user_memory_region(
+                    self,
+                    region.index as MemSlot,
+                    true,
+                    false,
+                    MemCacheType::CacheCoherent,
+                    region.guest_addr.offset(),
+                    region.size as u64,
+                    region.host_addr as *mut u8,
+                )
+            }?;
+        }
+        self.guest_mem.seal_private_regions()?;
+        let ranges = self
+            .guest_mem
+            .regions()
+            .filter(|r| matches!(r.backing, vm_memory::BackingObject::PrivateAnonymous))
+            .map(|r| (r.guest_addr, r.size as u64))
+            .collect::<Vec<_>>();
+        self.guest_mem.mark_mergeable_ranges(&ranges)?;
+        self.boot_sealed
+            .store(true, std::sync::atomic::Ordering::Release);
+        Ok(())
+    }
+
     fn add_memory_region(
         &self,
         guest_addr: GuestAddress,
