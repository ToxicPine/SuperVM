From 12c4e6eba28b2250729c3e70286d0d22e604d3d1 Mon Sep 17 00:00:00 2001
From: Arbion Halili <99731180+ToxicPine@users.noreply.github.com>
Date: Wed, 29 Jul 2026 00:23:23 +0100
Subject: [PATCH 1/6] base: add private anonymous mappings

Add a MAP_PRIVATE | MAP_ANONYMOUS builder and fallible madvise helpers for
KSM-eligible memory. Remove the ineffective MADV_MERGEABLE advice from the
shared mapping path.
---
 base/src/sys/linux/mmap.rs | 100 +++++++++++++++++++++++++++++++++----
 base/src/sys/linux/mod.rs  |   2 +-
 2 files changed, 90 insertions(+), 12 deletions(-)

diff --git a/base/src/sys/linux/mmap.rs b/base/src/sys/linux/mmap.rs
index 882236649..f88f66fa1 100644
--- a/base/src/sys/linux/mmap.rs
+++ b/base/src/sys/linux/mmap.rs
@@ -102,14 +102,28 @@ impl dyn MappedRegion {
     }
 }
 
-/// Wraps an anonymous shared memory mapping in the current process. Provides
-/// RAII semantics including munmap when no longer needed.
+/// Wraps a memory mapping in the current process and unmaps it on drop.
 #[derive(Debug)]
 pub struct MemoryMapping {
     addr: *mut u8,
     size: usize,
 }
 
+#[derive(Clone, Copy)]
+enum MmapSharing {
+    Private,
+    Shared,
+}
+
+impl MmapSharing {
+    fn flag(self) -> c_int {
+        match self {
+            Self::Private => libc::MAP_PRIVATE,
+            Self::Shared => libc::MAP_SHARED,
+        }
+    }
+}
+
 // SAFETY:
 // Send and Sync aren't automatically inherited for the raw address pointer.
 // Accessing that pointer is only done through the stateless interface which
@@ -145,6 +159,29 @@ impl MemoryMapping {
         unsafe { MemoryMapping::try_mmap(None, size, align, prot.into(), None) }
     }
 
+    /// Creates an anonymous private mapping that is not initially eligible for KSM.
+    fn new_private_anonymous(
+        size: usize,
+        align: Option<u64>,
+        prot: Protection,
+        populate: bool,
+    ) -> Result<MemoryMapping> {
+        // SAFETY:
+        // This is safe because we are creating an anonymous mapping in a place not already used by
+        // any other area in this process.
+        unsafe {
+            MemoryMapping::try_mmap_populate(
+                None,
+                size,
+                align,
+                prot.into(),
+                None,
+                populate,
+                MmapSharing::Private,
+            )
+        }
+    }
+
     /// Maps the first `size` bytes of the given `fd` as read/write.
     ///
     /// # Arguments
@@ -196,8 +233,8 @@ impl MemoryMapping {
         populate: bool,
     ) -> Result<MemoryMapping> {
         // SAFETY:
-        // This is safe because we are creating an anonymous mapping in a place not already used
-        // by any other area in this process.
+        // This is safe because we are creating a mapping in a place not already used by any other
+        // area in this process.
         unsafe {
             MemoryMapping::try_mmap_populate(
                 None,
@@ -206,6 +243,7 @@ impl MemoryMapping {
                 prot.into(),
                 Some((fd, offset)),
                 populate,
+                MmapSharing::Shared,
             )
         }
     }
@@ -263,7 +301,7 @@ impl MemoryMapping {
         prot: c_int,
         fd: Option<(&dyn AsRawDescriptor, u64)>,
     ) -> Result<MemoryMapping> {
-        MemoryMapping::try_mmap_populate(addr, size, align, prot, fd, false)
+        MemoryMapping::try_mmap_populate(addr, size, align, prot, fd, false, MmapSharing::Shared)
     }
 
     /// Helper wrapper around libc::mmap that does some basic validation, and calls
@@ -275,8 +313,9 @@ impl MemoryMapping {
         prot: c_int,
         fd: Option<(&dyn AsRawDescriptor, u64)>,
         populate: bool,
+        sharing: MmapSharing,
     ) -> Result<MemoryMapping> {
-        let mut flags = libc::MAP_SHARED;
+        let mut flags = sharing.flag();
         if populate {
             flags |= libc::MAP_POPULATE;
         }
@@ -380,11 +419,6 @@ impl MemoryMapping {
         // This is safe because we call madvise with a valid address and size.
         let _ = libc::madvise(addr, size, libc::MADV_DONTDUMP);
 
-        // This is safe because KSM's only userspace visible effects are timing
-        // and memory consumption; it doesn't affect rust safety semantics.
-        // KSM is also disabled by default, and this flag is only a hint.
-        let _ = libc::madvise(addr, size, libc::MADV_MERGEABLE);
-
         Ok(MemoryMapping {
             addr: addr as *mut u8,
             size,
@@ -861,6 +895,10 @@ impl CrateMemoryMapping {
 }
 
 pub trait MemoryMappingUnix {
+    /// Marks the specified range as eligible for Linux KSM.
+    fn mark_mergeable(&self, mem_offset: usize, count: usize) -> Result<()>;
+    /// Applies `MADV_DONTNEED` to the specified range.
+    fn madvise_dontneed(&self, mem_offset: usize, count: usize) -> Result<()>;
     /// Remove the specified range from the mapping.
     fn remove_range(&self, mem_offset: usize, count: usize) -> Result<()>;
     /// Tell the kernel to readahead the range.
@@ -876,6 +914,12 @@ pub trait MemoryMappingUnix {
 }
 
 impl MemoryMappingUnix for CrateMemoryMapping {
+    fn mark_mergeable(&self, mem_offset: usize, count: usize) -> Result<()> {
+        <dyn MappedRegion>::madvise(&self.mapping, mem_offset, count, libc::MADV_MERGEABLE)
+    }
+    fn madvise_dontneed(&self, mem_offset: usize, count: usize) -> Result<()> {
+        <dyn MappedRegion>::madvise(&self.mapping, mem_offset, count, libc::MADV_DONTNEED)
+    }
     fn remove_range(&self, mem_offset: usize, count: usize) -> Result<()> {
         self.mapping.remove_range(mem_offset, count)
     }
@@ -899,6 +943,8 @@ impl MemoryMappingUnix for CrateMemoryMapping {
 pub trait MemoryMappingBuilderUnix<'a> {
     #[allow(clippy::wrong_self_convention)]
     fn from_descriptor(self, descriptor: &'a dyn AsRawDescriptor) -> MemoryMappingBuilder<'a>;
+    /// Builds an anonymous private mapping that is not initially eligible for KSM.
+    fn build_private_anonymous(self) -> Result<CrateMemoryMapping>;
 }
 
 impl<'a> MemoryMappingBuilderUnix<'a> for MemoryMappingBuilder<'a> {
@@ -910,6 +956,21 @@ impl<'a> MemoryMappingBuilderUnix<'a> for MemoryMappingBuilder<'a> {
         self.descriptor = Some(descriptor);
         self
     }
+
+    fn build_private_anonymous(self) -> Result<CrateMemoryMapping> {
+        if self.descriptor.is_some() || self.offset.is_some() {
+            return Err(Error::InvalidArgument);
+        }
+        MemoryMappingBuilder::wrap(
+            MemoryMapping::new_private_anonymous(
+                self.size,
+                self.align,
+                self.protection.unwrap_or_else(Protection::read_write),
+                self.populate,
+            )?,
+            None,
+        )
+    }
 }
 
 impl<'a> MemoryMappingBuilder<'a> {
@@ -985,6 +1046,23 @@ mod tests {
         assert_eq!(1024, m.size());
     }
 
+    #[test]
+    fn private_anonymous_map_rejects_backing_options() {
+        let descriptor = Descriptor(-1);
+        assert!(matches!(
+            MemoryMappingBuilder::new(4096)
+                .from_descriptor(&descriptor)
+                .build_private_anonymous(),
+            Err(Error::InvalidArgument)
+        ));
+        assert!(matches!(
+            MemoryMappingBuilder::new(4096)
+                .offset(4096)
+                .build_private_anonymous(),
+            Err(Error::InvalidArgument)
+        ));
+    }
+
     #[test]
     fn map_invalid_size() {
         let res = MemoryMappingBuilder::new(0).build().unwrap_err();
