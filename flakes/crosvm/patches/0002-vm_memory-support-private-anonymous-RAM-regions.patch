+    /// Marks page-aligned guest-physical ranges as eligible for KSM.
+    ///
+    /// Every range is resolved and validated before any mapping is changed. If applying the advice
+    /// fails, ranges processed before the failure remain mergeable.
+    pub fn mark_mergeable_ranges(&self, ranges: &[(GuestAddress, u64)]) -> Result<()> {
+        let page_size = base::pagesize() as u64;
+        let mut resolved = Vec::new();
+
+        for &(addr, count) in ranges {
+            if count == 0 || addr.0 % page_size != 0 || count % page_size != 0 {
+                return Err(Error::InvalidGuestRange(addr, count));
+            }
+
+            let end = addr
+                .checked_add(count)
+                .ok_or(Error::InvalidGuestRange(addr, count))?;
+            let mut current = addr;
+            while current < end {
+                let region = self
+                    .regions
+                    .iter()
+                    .find(|region| region.contains(current))
+                    .ok_or(Error::InvalidGuestRange(addr, count))?;
+                if !matches!(&region.backing, BackingObject::PrivateAnonymous) {
+                    return Err(Error::MemoryRegionNotPrivateAnonymous);
+                }
+
+                let chunk_end = std::cmp::min(region.end(), end);
+                let offset = usize::try_from(current.offset_from(region.start()))
+                    .map_err(|_| Error::InvalidGuestRange(addr, count))?;
+                let size = usize::try_from(chunk_end.offset_from(current))
+                    .map_err(|_| Error::InvalidGuestRange(addr, count))?;
+                resolved.push((&region.mapping, current, offset, size));
+                current = chunk_end;
+            }
+        }
+
+        for (mapping, address, offset, size) in resolved {
+            mapping
+                .mark_mergeable(offset, size)
+                .map_err(|error| Error::MemoryAccess(address, error))?;
+        }
+        Ok(())
+    }
