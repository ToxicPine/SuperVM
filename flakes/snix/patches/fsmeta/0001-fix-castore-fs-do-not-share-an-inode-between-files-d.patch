 }
 
+impl InodeData {
+    /// The key under which this node is shared with identical ones, if it is a
+    /// regular file.
+    fn file_key(&self) -> Option<FileKey> {
+        match self {
+            InodeData::Regular(digest, _, executable) => Some(FileKey {
+                digest: *digest,
+                executable: *executable,
+            }),
+            _ => None,
+        }
+    }
+}
