+    /// Two files with identical contents but different modes are different
+    /// files. Sharing an inode between them would let whichever was looked up
+    /// first decide the mode of both, since the kernel caches attributes per
+    /// inode.
+    #[test]
+    fn put_regular_differing_in_mode() {
+        let mut inode_tracker = InodeTracker::default();
+
+        let plain = InodeData::Regular(
+            *fixtures::BLOB_A_DIGEST,
+            fixtures::BLOB_A.len() as u64,
+            false,
+        );
+        let executable = InodeData::Regular(
+            *fixtures::BLOB_A_DIGEST,
+            fixtures::BLOB_A.len() as u64,
+            true,
+        );
+
+        let plain_ino = inode_tracker.put(plain.clone());
+        let executable_ino = inode_tracker.put(executable.clone());
+
+        assert_ne!(plain_ino, executable_ino);
+
+        // and each keeps answering with what it was inserted as, in either
+        // order.
+        assert_eq!(executable_ino, inode_tracker.put(executable));
+        assert_eq!(plain_ino, inode_tracker.put(plain));
+
+        assert!(matches!(
+            *inode_tracker.get(plain_ino).unwrap(),
+            InodeData::Regular(_, _, false)
+        ));
+        assert!(matches!(
+            *inode_tracker.get(executable_ino).unwrap(),
+            InodeData::Regular(_, _, true)
+        ));
+    }
+
