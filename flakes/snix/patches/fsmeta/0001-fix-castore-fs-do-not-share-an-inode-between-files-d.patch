--- a/snix/castore/src/fs/inode_tracker.rs
+++ b/snix/castore/src/fs/inode_tracker.rs
@@ -3,6 +3,18 @@ use std::{collections::HashMap, sync::Arc};
 use super::inodes::{DirectoryInodeData, InodeData};
 use crate::B3Digest;
 
+/// What makes two regular files the same inode.
+///
+/// Not just the blob digest: two nodes with identical contents but different
+/// modes are different files, and the kernel is entitled to assume one inode
+/// has one set of attributes. Keying on the digest alone made whichever of them
+/// was looked up first decide the mode of both.
+#[derive(PartialEq, Eq, Hash)]
+struct FileKey {
+    digest: B3Digest,
+    executable: bool,
+}
+
 /// InodeTracker keeps track of inodes, stores data being these inodes and deals
