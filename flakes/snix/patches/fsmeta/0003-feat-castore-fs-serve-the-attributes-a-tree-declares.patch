index 0000000..bb8d317
--- /dev/null
+++ b/snix/castore/src/fs/attrs_tests.rs
@@ -0,0 +1,196 @@
+//! Serving filesystem attributes declared by a tree.
+
+use std::{collections::BTreeMap, ffi::CString, io::Cursor, sync::Arc};
+
+use fuse_backend_rs::api::filesystem::{
+    Context, FileSystem, GetxattrReply, ListxattrReply, ROOT_ID,
+};
+
+use crate::{
+    Directory, Node, PathComponent,
+    blobservice::{BlobService, MemoryBlobService},
+    directoryservice::DirectoryService,
+    fs::{FSSettings, SnixStoreFs},
+};
+
+const ROOT: &str = "00000000000000000000000000000000-test";
+
+type Fs = SnixStoreFs<
+    Arc<dyn BlobService>,
+    Arc<dyn DirectoryService>,
+    Arc<BTreeMap<PathComponent, Node>>,
+>;
+
+async fn mk_fs(declaration: Option<&str>) -> Arc<Fs> {
+    let blob_service = Arc::new(MemoryBlobService::default()) as Arc<dyn BlobService>;
+    let directory_service =
+        Arc::new(crate::utils::gen_test_directory_service()) as Arc<dyn DirectoryService>;
+
+    let put = async |contents: &[u8]| {
+        let mut writer = blob_service.open_write().await;
+        tokio::io::copy(&mut Cursor::new(contents), &mut writer)
+            .await
+            .unwrap();
+        writer.close().await.unwrap();
+    };
+
+    let contents = b"contents";
+    put(contents).await;
+    let data = Node::File {
+        digest: blake3::hash(contents).into(),
+        size: contents.len() as u64,
+        executable: false,
+    };
+
+    let mut root_nodes = vec![("data".try_into().unwrap(), data)];
+    if let Some(declaration) = declaration {
+        put(declaration.as_bytes()).await;
+        let declaration = Node::File {
+            digest: blake3::hash(declaration.as_bytes()).into(),
+            size: declaration.len() as u64,
+            executable: false,
+        };
+        let nix_support =
+            Directory::try_from_iter([("fsmeta".try_into().unwrap(), declaration)]).unwrap();
+        directory_service.put(nix_support.clone()).await.unwrap();
+        root_nodes.push((
+            "nix-support".try_into().unwrap(),
+            Node::Directory {
+                digest: nix_support.digest(),
+                size: nix_support.size(),
+            },
+        ));
+    }
+
+    let root = Directory::try_from_iter(root_nodes).unwrap();
+    directory_service.put(root.clone()).await.unwrap();
+
+    let root_nodes = BTreeMap::from([(
+        ROOT.try_into().unwrap(),
+        Node::Directory {
+            digest: root.digest(),
+            size: root.size(),
+        },
+    )]);
+
+    Arc::new(SnixStoreFs::new(
+        blob_service,
+        directory_service,
+        Arc::new(root_nodes),
+        FSSettings {
+            fsmeta_path: declaration.map(|_| "nix-support/fsmeta".parse().unwrap()),
+            ..Default::default()
+        },
+        tokio::runtime::Handle::current(),
+    ))
+}
+
+async fn data_inode(fs: &Arc<Fs>) -> u64 {
+    let fs = fs.clone();
+    tokio::task::spawn_blocking(move || {
+        let root = fs
+            .lookup(&Context::default(), ROOT_ID, &CString::new(ROOT).unwrap())
+            .unwrap();
+        fs.lookup(
+            &Context::default(),
+            root.inode,
+            &CString::new("data").unwrap(),
+        )
+        .unwrap()
+        .inode
+    })
+    .await
+    .unwrap()
+}
+
+#[tokio::test]
+async fn serves_user_attributes_but_not_snix_policy() {
+    let fs = mk_fs(Some(
+        "user.policy=c2hhcmVk data\n\
+         snix.dax data\n",
+    ))
+    .await;
+    let inode = data_inode(&fs).await;
+
+    tokio::task::spawn_blocking(move || {
+        let user = CString::new("user.policy").unwrap();
+        assert!(matches!(
+            fs.getxattr(&Context::default(), inode, &user, 0).unwrap(),
+            GetxattrReply::Count(6)
+        ));
+        assert!(matches!(
+            fs.getxattr(&Context::default(), inode, &user, 6)
+                .unwrap(),
+            GetxattrReply::Value(value) if value == b"shared"
+        ));
+
+        assert!(matches!(
+            fs.listxattr(&Context::default(), inode, 0).unwrap(),
+            ListxattrReply::Count(12)
+        ));
+        assert!(matches!(
+            fs.listxattr(&Context::default(), inode, 12).unwrap(),
+            ListxattrReply::Names(names) if names == b"user.policy\0"
+        ));
+
+        let policy = CString::new("snix.dax").unwrap();
+        assert_eq!(
+            Some(libc::ENODATA),
+            fs.getxattr(&Context::default(), inode, &policy, 0)
+                .err()
+                .unwrap()
+                .raw_os_error(),
+        );
+    })
+    .await
+    .unwrap();
+}
+
+#[tokio::test]
+async fn disabled_declarations_preserve_xattrs_unsupported() {
+    let fs = mk_fs(None).await;
+    let inode = data_inode(&fs).await;
+
+    tokio::task::spawn_blocking(move || {
+        let name = CString::new("user.anything").unwrap();
+        assert_eq!(
+            Some(libc::ENOSYS),
+            fs.getxattr(&Context::default(), inode, &name, 0)
+                .err()
+                .unwrap()
+                .raw_os_error(),
+        );
+        assert_eq!(
+            Some(libc::ENOSYS),
+            fs.listxattr(&Context::default(), inode, 0)
+                .err()
+                .unwrap()
+                .raw_os_error(),
+        );
+    })
+    .await
+    .unwrap();
+}
+
+#[tokio::test]
+async fn malformed_declarations_are_ignored() {
+    let fs = mk_fs(Some("this is not a declaration\n")).await;
+    let inode = data_inode(&fs).await;
+
+    tokio::task::spawn_blocking(move || {
+        let name = CString::new("user.anything").unwrap();
+        assert_eq!(
+            Some(libc::ENODATA),
+            fs.getxattr(&Context::default(), inode, &name, 0)
+                .err()
+                .unwrap()
+                .raw_os_error(),
+        );
+        assert!(matches!(
+            fs.listxattr(&Context::default(), inode, 0).unwrap(),
+            ListxattrReply::Count(0)
+        ));
+    })
+    .await
+    .unwrap();
+}
