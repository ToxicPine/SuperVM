+/// Answers a listxattr, honouring the size-probe convention.
+fn reply_names(names: Vec<u8>, size: u32) -> io::Result<ListxattrReply> {
+    if size == 0 {
+        Ok(ListxattrReply::Count(names.len() as u32))
+    } else if size < names.len() as u32 {
+        Err(io::Error::from_raw_os_error(libc::ERANGE))
+    } else {
+        Ok(ListxattrReply::Names(names))
