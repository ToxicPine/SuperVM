+++ b/snix/castore/src/fs/index_tests.rs
@@ -0,0 +1,379 @@
+//! Serving a filesystem from a shared metadata index.
+//!
+//! These drive the [FileSystem] trait directly, as the FUSE and virtio-fs
+//! daemons do, over a filesystem whose inodes come from an index built offline.
+//! The directory service handed to the serving filesystem is a mock that must
+//! never be called: proving the index answers metadata on its own is the whole
+//! point.
+
+use std::{collections::BTreeMap, ffi::CString, io::Cursor, sync::Arc};
+
+use fuse_backend_rs::api::filesystem::{Context, FileSystem, ROOT_ID};
+
+use crate::{
+    Directory, Node, PathComponent,
+    attrs::AttrTree,
+    blobservice::{BlobService, MemoryBlobService},
+    directoryservice::{DirectoryService, MockDirectoryService},
+    fs::{
+        FSSettings, SnixStoreFs,
+        index::{SharedIndex, build_from_roots},
+    },
+};
+
+const ROOT: &str = "00000000000000000000000000000000-root";
+
+type Fs = SnixStoreFs<
+    Arc<dyn BlobService>,
+    Arc<dyn DirectoryService>,
+    Arc<BTreeMap<PathComponent, Node>>,
+>;
+
+fn pc(s: &str) -> PathComponent {
+    s.try_into().unwrap()
+}
+
+/// Builds a tree — `bin/hello`, `share/doc` (both one blob) and a symlink — with
+/// the given declaration applying to it, and returns the serialized index plus
+/// the blob service backing the file contents.
+async fn sample_index(declaration: &str) -> (Vec<u8>, Arc<dyn BlobService>) {
+    let blob_service = Arc::new(MemoryBlobService::default()) as Arc<dyn BlobService>;
+    let directory_service = crate::utils::gen_test_directory_service();
+
+    let mut w = blob_service.open_write().await;
+    tokio::io::copy(&mut Cursor::new(crate::fixtures::BLOB_A.to_vec()), &mut w)
+        .await
+        .unwrap();
+    w.close().await.unwrap();
+
+    let blob_a = Node::File {
+        digest: *crate::fixtures::BLOB_A_DIGEST,
+        size: crate::fixtures::BLOB_A.len() as u64,
+        executable: false,
+    };
+
+    let mk_dir = async |name: &str, node: Node| -> Node {
+        let d = Directory::try_from_iter([(pc(name), node)]).unwrap();
+        directory_service.put(d.clone()).await.unwrap();
+        Node::Directory {
+            digest: d.digest(),
+            size: d.size(),
+        }
+    };
+
+    let bin = mk_dir("hello", blob_a.clone()).await;
+    let share = mk_dir("doc", blob_a).await;
+
+    let root = Directory::try_from_iter([
+        (pc("bin"), bin),
+        (
+            pc("link"),
+            Node::Symlink {
+                target: "somewhere".try_into().unwrap(),
+            },
+        ),
+        (pc("share"), share),
+    ])
+    .unwrap();
+    directory_service.put(root.clone()).await.unwrap();
+
+    let root_node = Node::Directory {
+        digest: root.digest(),
+        size: root.size(),
+    };
+    let declared = AttrTree::parse(declaration.as_bytes()).unwrap();
+    let bytes = build_from_roots(&directory_service, [(pc(ROOT), root_node, declared)])
+        .await
+        .expect("build index");
+
+    (bytes, blob_service)
+}
+
+/// A serving filesystem over `bytes`, whose directory service must never be
+/// consulted: everything the index covers is answered from the mapping.
+fn indexed_fs(bytes: Vec<u8>, blob_service: Arc<dyn BlobService>) -> Arc<Fs> {
+    let mut directory_service = MockDirectoryService::new();
+    directory_service.expect_get().times(0);
+
+    let fs = SnixStoreFs::new(
+        blob_service,
+        Arc::new(directory_service) as Arc<dyn DirectoryService>,
+        Arc::new(BTreeMap::new()),
+        FSSettings {
+            list_root: true,
+            show_xattr: true,
+            ..Default::default()
+        },
+        tokio::runtime::Handle::current(),
+    )
+    .with_index(SharedIndex::from_bytes(bytes).expect("valid index"));
+
+    Arc::new(fs)
+}
+
+/// Filesystem calls block on the tokio handle, so they must run off the runtime
+/// thread, exactly as the daemons run them.
+async fn on_fs<T: Send + 'static>(fs: &Arc<Fs>, f: impl FnOnce(&Fs) -> T + Send + 'static) -> T {
+    let fs = fs.clone();
+    tokio::task::spawn_blocking(move || f(&fs)).await.unwrap()
+}
+
+async fn lookup_path(fs: &Arc<Fs>, path: &[&str]) -> fuse_backend_rs::api::filesystem::Entry {
+    let path: Vec<CString> = path.iter().map(|p| CString::new(*p).unwrap()).collect();
+    on_fs(fs, move |fs| {
+        let mut ino = ROOT_ID;
+        let mut entry = None;
+        for name in &path {
+            let e = fs.lookup(&Context::default(), ino, name).expect("lookup");
+            ino = e.inode;
+            entry = Some(e);
+        }
+        entry.expect("at least one component")
+    })
+    .await
+}
+
+/// The point of a *shared* index: two filesystems over the same file report the
+/// same inode for the same path, with no coordination beyond the artifact.
+#[tokio::test]
+async fn two_filesystems_agree_on_every_inode() {
+    let (bytes, blobs) = sample_index("# nothing\n").await;
+    let a = indexed_fs(bytes.clone(), blobs.clone());
+    let b = indexed_fs(bytes, blobs);
+
+    for path in [
+        &[ROOT][..],
+        &[ROOT, "bin"],
+        &[ROOT, "bin", "hello"],
+        &[ROOT, "share", "doc"],
+        &[ROOT, "link"],
+    ] {
+        assert_eq!(
+            lookup_path(&a, path).await.inode,
+            lookup_path(&b, path).await.inode,
+            "path {path:?} must resolve to the same inode",
+        );
+    }
+}
+
+/// Metadata for indexed content is answered entirely from the index: lookup,
+/// getattr, readdir, readlink and xattr all succeed against a directory service
+/// that panics if touched.
+#[tokio::test]
+async fn indexed_metadata_needs_no_directory_service() {
+    let (bytes, blobs) = sample_index("# nothing\n").await;
+    let fs = indexed_fs(bytes, blobs);
+
+    let root = lookup_path(&fs, &[ROOT]).await.inode;
+    let bin = lookup_path(&fs, &[ROOT, "bin"]).await.inode;
+    let hello = lookup_path(&fs, &[ROOT, "bin", "hello"]).await.inode;
+    let link = lookup_path(&fs, &[ROOT, "link"]).await.inode;
+
+    on_fs(&fs, move |fs| {
+        let ctx = Context::default();
+
+        // getattr on each kind.
+        for ino in [root, bin, hello, link] {
+            fs.getattr(&ctx, ino, None).expect("getattr");
+        }
+
+        // readdir of the mount root and of an indexed directory.
+        let mut names = Vec::new();
+        fs.readdir(&ctx, ROOT_ID, 0, 4096, 0, &mut |e| {
+            names.push(String::from_utf8_lossy(e.name).into_owned());
+            Ok(1)
+        })
+        .expect("readdir root");
+        assert_eq!(names, vec![ROOT.to_string()]);
+
+        let mut names = Vec::new();
+        fs.readdir(&ctx, bin, 0, 4096, 0, &mut |e| {
+            names.push(String::from_utf8_lossy(e.name).into_owned());
+            Ok(1)
+        })
+        .expect("readdir bin");
+        assert_eq!(names, vec!["hello".to_string()]);
+
+        // readlink of the symlink.
+        assert_eq!(fs.readlink(&ctx, link).expect("readlink"), b"somewhere");
+    })
+    .await;
+}
+
+/// Declared attributes — a served `user.` xattr — resolved into the index are
+/// answered from it and match what the tree declared.
+#[tokio::test]
+async fn declared_xattrs_are_served_from_the_index() {
+    let (bytes, blobs) = sample_index("user.mime=dGV4dC9wbGFpbg== bin/hello\n").await;
+    let fs = indexed_fs(bytes, blobs);
+
+    let hello = lookup_path(&fs, &[ROOT, "bin", "hello"]).await.inode;
+    let doc = lookup_path(&fs, &[ROOT, "share", "doc"]).await.inode;
+
+    on_fs(&fs, move |fs| {
+        use fuse_backend_rs::api::filesystem::GetxattrReply;
+        let ctx = Context::default();
+        let name = CString::new("user.mime").unwrap();
+
+        assert!(matches!(
+            fs.getxattr(&ctx, hello, &name, 64).unwrap(),
+            GetxattrReply::Value(v) if v == b"text/plain",
+        ));
+        // share/doc is the same blob but carries no declaration, so it must be a
+        // different inode and must not answer the attribute.
+        assert_ne!(hello, doc);
+        assert_eq!(
+            fs.getxattr(&ctx, doc, &name, 64)
+                .err()
+                .unwrap()
+                .raw_os_error(),
+            Some(libc::ENODATA),
+        );
+    })
+    .await;
+}
+
+/// A FORGET for an indexed inode is a no-op: its metadata is shared and
+/// immutable, so it stays resolvable however many times it is forgotten.
+#[tokio::test]
+async fn forgetting_an_indexed_inode_is_a_noop() {
+    let (bytes, blobs) = sample_index("# nothing\n").await;
+    let fs = indexed_fs(bytes, blobs);
+
+    let hello = lookup_path(&fs, &[ROOT, "bin", "hello"]).await.inode;
+
+    on_fs(&fs, move |fs| {
+        let ctx = Context::default();
+        fs.forget(&ctx, hello, u64::MAX);
+        fs.batch_forget(&ctx, vec![(hello, u64::MAX)]);
+        fs.getattr(&ctx, hello, None)
+            .expect("an indexed inode survives being forgotten");
+    })
+    .await;
+}
+
+/// A root the index does not cover falls back to the tracker, is allocated an
+/// inode strictly above the index's range, and is evicted by a FORGET as
+/// before — while an indexed root in the same filesystem is not.
+#[tokio::test]
+async fn a_non_indexed_root_uses_the_overlay_and_still_evicts() {
+    let (bytes, blobs) = sample_index("# nothing\n").await;
+    let overlay_base = SharedIndex::from_bytes(bytes.clone())
+        .unwrap()
+        .overlay_base();
+
+    // A real directory service, since the overlay path resolves through it, plus
+    // a provider carrying one extra root the index does not cover.
+    let directory_service =
+        Arc::new(crate::utils::gen_test_directory_service()) as Arc<dyn DirectoryService>;
+    let other = "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz-other";
+    let provider: BTreeMap<PathComponent, Node> = BTreeMap::from([(
+        pc(other),
+        Node::File {
+            digest: *crate::fixtures::BLOB_B_DIGEST,
+            size: crate::fixtures::BLOB_B.len() as u64,
+            executable: false,
+        },
+    )]);
+
+    let fs = Arc::new(
+        SnixStoreFs::new(
+            blobs,
+            directory_service,
+            Arc::new(provider),
+            FSSettings {
+                list_root: true,
+                show_xattr: true,
+                ..Default::default()
+            },
+            tokio::runtime::Handle::current(),
+        )
+        .with_index(SharedIndex::from_bytes(bytes).unwrap()),
+    );
+
+    let indexed_root = lookup_path(&fs, &[ROOT]).await.inode;
+    let overlay_root = lookup_path(&fs, &[other]).await.inode;
+
+    assert!(
+        indexed_root < overlay_base,
+        "the indexed root is in the index range"
+    );
+    assert!(
+        overlay_root >= overlay_base,
+        "an overlay inode must be allocated above the index range",
+    );
+
+    on_fs(&fs, move |fs| {
+        let ctx = Context::default();
+
+        // Forgetting the overlay inode evicts it, as without an index.
+        fs.forget(&ctx, overlay_root, 1);
+        assert_eq!(
+            fs.getattr(&ctx, overlay_root, None)
+                .err()
+                .unwrap()
+                .raw_os_error(),
+            Some(libc::ESTALE),
+            "a forgotten overlay inode is stale",
+        );
+
+        // Forgetting the indexed root does nothing.
+        fs.forget(&ctx, indexed_root, u64::MAX);
+        fs.getattr(&ctx, indexed_root, None)
+            .expect("the indexed root survives being forgotten");
+    })
+    .await;
+}
+
+/// The per-inode DAX hint the tree declares is resolved into the index and
+/// answered from it: exactly the marked file is flagged, and a guest deciding
+/// per inode sees the mark in the lookup reply.
+#[cfg(feature = "virtiofs")]
+#[tokio::test]
+async fn declared_dax_is_served_from_the_index() {
+    use fuse_backend_rs::{abi::fuse_abi::FUSE_ATTR_DAX, api::filesystem::FsOptions};
+
+    let (bytes, blobs) = sample_index(&format!("{} bin/hello\n", crate::attrs::ATTR_DAX)).await;
+
+    let dir = tempfile::TempDir::new().unwrap();
+    let mut directory_service = MockDirectoryService::new();
+    directory_service.expect_get().times(0);
+    let fs = Arc::new(
+        SnixStoreFs::new(
+            blobs,
+            Arc::new(directory_service) as Arc<dyn DirectoryService>,
+            Arc::new(BTreeMap::new()),
+            FSSettings {
+                list_root: true,
+                show_xattr: true,
+                ..Default::default()
+            },
+            tokio::runtime::Handle::current(),
+        )
+        .with_index(SharedIndex::from_bytes(bytes).unwrap())
+        .with_dax_cache(crate::fs::dax::DaxCache::new(dir.path()).unwrap()),
+    );
+
+    on_fs(&fs, |fs| {
+        assert!(
+            fs.init(FsOptions::INIT_EXT | FsOptions::PERFILE_DAX)
+                .unwrap()
+                .contains(FsOptions::PERFILE_DAX)
+        );
+    })
+    .await;
+
+    let hello = lookup_path(&fs, &[ROOT, "bin", "hello"]).await;
+    let doc = lookup_path(&fs, &[ROOT, "share", "doc"]).await;
+
+    assert_eq!(
+        FUSE_ATTR_DAX,
+        hello.attr_flags & FUSE_ATTR_DAX,
+        "bin/hello is marked"
+    );
+    assert_eq!(0, doc.attr_flags & FUSE_ATTR_DAX, "share/doc is not");
+    assert_ne!(
+        hello.inode, doc.inode,
+        "the same blob, split by its declaration"
+    );
+}
diff --git a/snix/castore/src/fs/inode_tracker.rs b/snix/castore/src/fs/inode_tracker.rs
