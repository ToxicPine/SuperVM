+    /// Answers a getxattr for an indexed inode: the extended attributes the tree
+    /// declared, resolved into the index at build time, plus the synthetic
+    /// digest attributes when those are enabled.
+    fn index_getxattr(&self, inode: u64, name: &CStr, size: u32) -> io::Result<GetxattrReply> {
+        let index = self.index().expect("indexed inode implies an index");
+        let record = index
+            .record(inode)
+            .ok_or_else(|| io::Error::from_raw_os_error(libc::ESTALE))?;
+
+        // A declared attribute is an attribute of the file whether or not the
+        // synthetic digest attributes are enabled.
+        if let Some(value) = record
+            .attrs_ref()
+            .and_then(|attrs_ref| index.xattr_get(attrs_ref, name.to_bytes()))
+        {
+            return reply_xattr(value, size);
+        }
+
+        if !self.settings.show_xattr {
+            return Err(io::Error::from_raw_os_error(libc::ENODATA));
+        }
+
+        let digest_str = match record {
+            Record::Directory { digest, .. } if name.to_bytes() == XATTR_NAME_DIRECTORY_DIGEST => {
+                digest.to_string()
+            }
+            Record::File { digest, .. } if name.to_bytes() == XATTR_NAME_BLOB_DIGEST => {
+                digest.to_string()
+            }
+            _ => return Err(io::Error::from_raw_os_error(libc::ENODATA)),
+        };
+        reply_xattr(digest_str.as_bytes(), size)
+    }
+
+    /// Answers a listxattr for an indexed inode, mirroring [Self::index_getxattr]:
+    /// the declared attribute names, then the synthetic digest name.
+    fn index_listxattr(&self, inode: u64, size: u32) -> io::Result<ListxattrReply> {
+        let index = self.index().expect("indexed inode implies an index");
+        let record = index
+            .record(inode)
+            .ok_or_else(|| io::Error::from_raw_os_error(libc::ESTALE))?;
+
+        let mut out = Vec::new();
+        if let Some(attrs_ref) = record.attrs_ref() {
+            for (name, _value) in index.xattrs(attrs_ref) {
+                out.extend_from_slice(name);
+                out.push_byte(b'\x00');
+            }
+        }
+
+        if self.settings.show_xattr {
+            match record {
+                Record::Directory { .. } => {
+                    out.extend_from_slice(XATTR_NAME_DIRECTORY_DIGEST);
+                    out.push_byte(b'\x00');
+                }
+                Record::File { .. } => {
+                    out.extend_from_slice(XATTR_NAME_BLOB_DIGEST);
+                    out.push_byte(b'\x00');
+                }
+                Record::Symlink { .. } => {}
+            }
+        }
+
+        reply_names(out, size)
+    }
