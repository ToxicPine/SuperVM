+++ b/snix/castore/src/fs/inode_tracker.rs
@@ -133,6 +133,19 @@ impl InodeData {
 }
 
 impl InodeTracker {
+    /// Moves the next inode to allocate up to `next_inode`, so overlay inodes
+    /// begin above a shared index's range rather than colliding with it.
+    ///
+    /// Only valid before any inode has been handed out, which is the only time
+    /// [`super::SnixStoreFs::with_index`] calls it.
+    pub fn rebase(&mut self, next_inode: u64) {
+        debug_assert!(
+            self.data.is_empty() && self.next_inode == 2,
+            "the inode tracker must be rebased before any allocation"
+        );
+        self.next_inode = next_inode;
+    }
+
     // Retrieves data for a given inode, if it exists.
     pub fn get(&self, ino: u64) -> Option<Arc<InodeData>> {
         self.data.get(&ino).cloned()
