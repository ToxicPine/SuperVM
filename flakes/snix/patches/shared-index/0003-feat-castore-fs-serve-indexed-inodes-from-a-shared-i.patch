@@ -539,6 +577,159 @@ where
         attr
     }
 
+    /// The index, if one is attached.
+    fn index(&self) -> Option<&SharedIndex> {
+        self.index.as_ref()
+    }
+
+    /// Whether `ino` is served from the shared index rather than the tracker.
+    fn is_index_inode(&self, ino: u64) -> bool {
+        self.index().is_some_and(|index| index.is_index_inode(ino))
+    }
+
+    /// The [Attr] for an indexed inode, built straight from its record.
+    fn index_attr(&self, ino: u64) -> Option<Attr> {
+        let record = self.index()?.record(ino)?;
+        let (mode, size) = match record {
+            Record::Directory { size, .. } => (libc::S_IFDIR | 0o555, size),
+            Record::File {
+                size,
+                executable: true,
+                ..
+            } => (libc::S_IFREG | 0o555, size),
+            Record::File { size, .. } => (libc::S_IFREG | 0o444, size),
+            Record::Symlink { target } => (libc::S_IFLNK | 0o444, target.len() as u64),
+        };
+        // libc::S_IFREG, libc::S_IFLNK & libc::S_IFDIR are u32 on Linux and u16 on MacOS
+        #[cfg(target_os = "macos")]
+        let mode = mode as u32;
+        Some(self.make_attr(ino, mode, size))
+    }
+
+    /// The lookup/readdirplus [Entry] for an indexed inode, marking it for DAX
+    /// exactly when its record says the tree asked for it and a guest that
+    /// decides per inode is being served.
+    fn index_entry(&self, ino: u64) -> Option<Entry> {
+        #[allow(unused_mut)]
+        let mut entry = attr_to_fuse_entry(self.index_attr(ino)?);
+
+        #[cfg(all(feature = "virtiofs", target_os = "linux"))]
+        if self.index_dax_eligible(ino) {
+            entry.attr_flags |= fuse_backend_rs::abi::fuse_abi::FUSE_ATTR_DAX;
+            debug!(ino, "marking indexed inode to be mapped rather than read");
+        }
+
+        Some(entry)
+    }
+
+    /// Whether the guest should map this indexed inode rather than read it. The
+    /// same four conditions as [Self::dax_eligible], with the DAX hint read from
+    /// the record the index resolved at build time.
+    #[cfg(all(feature = "virtiofs", target_os = "linux"))]
+    fn index_dax_eligible(&self, ino: u64) -> bool {
+        use std::sync::atomic::Ordering;
+
+        self.perfile_dax.load(Ordering::Relaxed)
+            && self.dax_cache.is_some()
