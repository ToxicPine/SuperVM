@@ -190,6 +205,20 @@ where
         self
     }
 
+    /// Serve the inodes covered by `index` straight from it.
+    ///
+    /// The index owns a fixed, dense inode range starting at
+    /// [index::INODE_BASE]; the inode tracker is rebased to allocate overlay
+    /// inodes strictly above it, so a root the index does not cover, or content
+    /// fetched past the index, never collides with an indexed inode. Attaching
+    /// an index before anything has been looked up is the only supported order,
+    /// which is how the daemons build the filesystem.
+    pub fn with_index(mut self, index: SharedIndex) -> Self {
+        self.inode_tracker.get_mut().rebase(index.overlay_base());
+        self.index = Some(index);
+        self
+    }
+
     pub fn new(
         blob_service: BS,
         directory_service: DS,
@@ -206,6 +235,7 @@ where
             settings,
 
