+    /// The FUSE directory-entry type of an indexed inode.
+    fn index_fuse_type(&self, ino: u64) -> u32 {
+        #[allow(clippy::let_and_return)]
+        let ty = match self.index().and_then(|index| index.record(ino)) {
+            Some(Record::Directory { .. }) => libc::S_IFDIR,
+            Some(Record::File { .. }) => libc::S_IFREG,
+            Some(Record::Symlink { .. }) | None => libc::S_IFLNK,
+        };
+        // libc::S_IFDIR is u32 on Linux and u16 on MacOS
+        #[cfg(target_os = "macos")]
+        let ty = ty as u32;
+        ty
+    }
