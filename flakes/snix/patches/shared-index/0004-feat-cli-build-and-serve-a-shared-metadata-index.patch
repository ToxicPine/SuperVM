+
+            // The roots are the directory's children, exactly as `snix castore
+            // virtiofs` serves them; castore carries no declaration convention.
+            let roots: Vec<_> = directory.into_nodes().collect();
+            let bytes =
+                build_from_root_nodes(&blob_service, &directory_service, roots, None).await?;
+
+            write_atomically(&output, &bytes)?;
+            tracing::info!(output = ?output, bytes = bytes.len(), "wrote metadata index");
