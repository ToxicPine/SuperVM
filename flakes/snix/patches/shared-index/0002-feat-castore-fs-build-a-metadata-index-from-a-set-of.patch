 //! the extended attributes and the per-inode DAX hint straight from the mapping,
 //! touching neither its heap nor the directory service.
 //!
-//! # Determinism
+//! # Identity and determinism
 //!
-//! The [writer][format::write] is a pure function of the records handed to it,
-//! so the same input always produces byte-identical output and every daemon
-//! mapping one file agrees on every inode by construction, without any hashing
-//! or coordination. The [builder][mod@self] that turns a store into those
-//! records is added on top of this format.
+//! Inode numbers are assigned once, when the index is [built][build_from_roots]:
+//! the builder walks the roots through the directory service exactly as the
+//! filesystem would, evaluating the same attribute declarations, and gives every
+//! distinct identity — the same [FileKey]/[DirKey]/symlink-target the inode
+//! tracker keys on — one dense inode number counting up from [format::INODE_BASE].
+//! The walk is deterministic (roots and children in sorted order, no timestamps,
+//! no randomness), so the same input always produces byte-identical output and
+//! every daemon mapping one file agrees on every inode by construction, without
+//! any hashing or coordination.
+//!
+//! [FileKey]: super::inode_tracker
+//! [DirKey]: super::inode_tracker
 
+mod builder;
 mod format;
 mod mmap;
 
+pub use builder::{BuildError, build_from_root_nodes, build_from_roots};
 pub use format::{
     DIRENT_SIZE, HEADER_SIZE, INODE_BASE, Index, IndexError, Kind, RECORD_SIZE, Record,
     RecordAttrs, RecordSpec, VERSION, write,
