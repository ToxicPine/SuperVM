--- a/snix/castore/src/fs/mod.rs
+++ b/snix/castore/src/fs/mod.rs
@@ -116,6 +116,13 @@ pub struct SnixStoreFs<BS, DS, RN: RootNodes> {
     next_file_handle: AtomicU64,
 
     tokio_handle: tokio::runtime::Handle,
+
+    /// Backing store for DAX mappings, if the filesystem is serving them.
+    ///
+    /// Without one, `setupmapping` reports `ENOSYS` and guests fall back to
+    /// ordinary reads.
