 }
 
 /// Configures some filesystem settings
@@ -137,6 +144,17 @@ where
     DS: DirectoryService,
     RN: RootNodes,
 {
+    /// Serve DAX mappings for regular files, backed by `dax_cache`.
+    ///
+    /// Blobs are materialized into the cache on demand. Point several
+    /// filesystems at one cache directory to have them share host pages for
+    /// blobs they both map.
+    #[cfg(feature = "virtiofs")]
+    pub fn with_dax_cache(mut self, dax_cache: dax::DaxCache) -> Self {
+        self.dax_cache = Some(dax_cache);
+        self
+    }
+
     pub fn new(
         blob_service: BS,
         directory_service: DS,
@@ -161,6 +179,9 @@ where
             file_handles: RwLock::new(Default::default()),
             next_file_handle: AtomicU64::new(1),
             tokio_handle,
+
+            #[cfg(feature = "virtiofs")]
+            dax_cache: None,
         }
     }
 
@@ -870,6 +891,80 @@ where
         Ok(bytes_written as usize)
     }
 
+    /// Sets up a DAX mapping for a regular file.
+    ///
+    /// Blob contents are streamed and have no descriptor of their own, so the
+    /// blob is materialized into the configured [dax::DaxCache] and the
+    /// resulting descriptor is handed to the VMM. Guests sharing a cache
+    /// directory therefore map the same host file for the same blob.
+    ///
+    /// Reports `ENOSYS` when no cache is configured, which makes the guest fall
+    /// back to ordinary reads.
+    #[cfg(feature = "virtiofs")]
+    #[tracing::instrument(skip_all, fields(rq.inode = inode, rq.foffset = foffset, rq.len = len, rq.moffset = moffset), err)]
+    fn setupmapping(
+        &self,
+        _ctx: &Context,
+        inode: Self::Inode,
+        _handle: Self::Handle,
+        foffset: u64,
+        len: u64,
+        flags: u64,
+        moffset: u64,
+        vu_req: &mut dyn fuse_backend_rs::transport::FsCacheReqHandler,
+    ) -> io::Result<()> {
+        use fuse_backend_rs::abi::virtio_fs::SetupmappingFlags;
+        use std::os::fd::AsRawFd;
+
+        let Some(dax_cache) = self.dax_cache.as_ref() else {
+            return Err(io::Error::from_raw_os_error(libc::ENOSYS));
+        };
+
+        // A castore is immutable, and the cache entry is shared between every
+        // guest mapping that blob. A writable mapping could never be honoured.
+        if flags & SetupmappingFlags::WRITE.bits() != 0 {
+            warn!("rejecting writable DAX mapping");
+            return Err(io::Error::from_raw_os_error(libc::EROFS));
+        }
+
+        let blob_digest = match *self.inode_tracker.read().get(inode).ok_or_else(|| {
+            warn!("inode not found");
+            io::Error::from_raw_os_error(libc::EBADF)
+        })? {
+            InodeData::Regular(ref blob_digest, _, _) => *blob_digest,
