+        let ino = self.root_nodes.read().get(name).cloned()?;
+        self.inode_tracker.read().get(ino).map(|_| ino)
     }
 
     /// For a given inode, look up the given directory behind it (from
@@ -188,6 +194,24 @@ where
         match *data {
             // if it's populated already, return children.
             InodeData::Directory(DirectoryInodeData::Populated(parent_digest, ref children)) => {
+                // The kernel may still reference children of this cached
+                // directory that it has since forgotten, and which we therefore
+                // evicted. Reinstate their data under the same inode numbers
