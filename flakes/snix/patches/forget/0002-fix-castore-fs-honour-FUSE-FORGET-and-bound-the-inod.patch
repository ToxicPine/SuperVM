 snix/castore/src/fs/inode_tracker.rs | 384 ++++++++++++++++++++++++++-
 snix/castore/src/fs/mod.rs           | 322 +++++++++++++++++++---
 2 files changed, 668 insertions(+), 38 deletions(-)

diff --git a/snix/castore/src/fs/inode_tracker.rs b/snix/castore/src/fs/inode_tracker.rs
index e0c072d..dd08c6b 100644
--- a/snix/castore/src/fs/inode_tracker.rs
+++ b/snix/castore/src/fs/inode_tracker.rs
@@ -5,6 +5,37 @@ use crate::B3Digest;
 
 /// InodeTracker keeps track of inodes, stores data being these inodes and deals
 /// with inode allocation.
+///
+/// # Inode lifetime
+///
+/// FUSE inodes are reference-counted by the kernel. Every reply that hands the
+/// kernel an `Entry` for an inode (a `lookup`, or a `readdirplus` entry) adds
+/// one to that inode's *lookup count*; a `FORGET` request carries the number of
+/// references to drop. The kernel guarantees it will not use an inode again
+/// once it has forgotten it down to zero without looking it up anew.
+///
+/// The tracker mirrors that count in [`InodeTracker::lookup_counts`]. When a
+/// count reaches zero the inode is *evicted*: its data and the reverse-lookup
+/// entry that maps its content to it are both removed, so the number is free to
+/// be reused and the tracker no longer grows without bound for the life of a
+/// mount. Content-addressed deduplication means several paths can resolve to
+/// one inode; their lookups accumulate on that single count, so eviction only
+/// happens once the *last* reference is forgotten.
+///
+/// Enumeration does not take a reference: a plain `readdir` hands the kernel a
+/// child's inode number without an `Entry`, so those children sit at a zero
+/// lookup count and no FORGET ever names them. To keep an enumerate-only
+/// workload from leaking them, evicting a populated directory *sweeps* its
+/// zero-count children (see [`Self::evict`]).
+///
+/// Inodes are handed out by [`InodeTracker::put`], which deduplicates by
+/// content, so re-`put`ting the same content after an eviction allocates a
+/// *fresh* inode rather than resurrecting the old number.
+///
+/// One class of zero-count residue is not reclaimed: entries of the mount root
+/// enumerated under `list_root`. The root inode is permanent and never held
+/// here, so there is no populated directory whose eviction would sweep them;
+/// they are instead bounded by, and pinned to, the root listing itself.
 pub struct InodeTracker {
     data: HashMap<u64, Arc<InodeData>>,
 
@@ -18,6 +49,10 @@ pub struct InodeTracker {
     // Note the corresponding directory may not be present in data yet.
     directory_digest_to_inode: HashMap<B3Digest, u64>,
 
+    // The number of outstanding kernel references (the FUSE "lookup count") for
+    // each inode. An inode absent from this map has no outstanding references.
+    lookup_counts: HashMap<u64, u64>,
+
     // the next inode to allocate
     next_inode: u64,
 }
@@ -30,6 +65,7 @@ impl Default for InodeTracker {
             blob_digest_to_inode: Default::default(),
             symlink_target_to_inode: Default::default(),
             directory_digest_to_inode: Default::default(),
+            lookup_counts: Default::default(),
 
             next_inode: 2,
         }
@@ -42,12 +78,15 @@ impl InodeTracker {
         self.data.get(&ino).cloned()
     }
 
-    // Replaces data for a given inode.
-    // Panics if the inode doesn't already exist.
+    // Replaces the data for a given inode, e.g. to upgrade a directory from
+    // [DirectoryInodeData::Sparse] to [DirectoryInodeData::Populated].
+    //
+    // The inode number and its lookup count are left untouched. If the inode
+    // was concurrently evicted by a FORGET this reinstates its data, which is
+    // harmless: the caller reached it through a live parent that still holds a
+    // kernel reference to it.
     pub fn replace(&mut self, ino: u64, data: Arc<InodeData>) {
-        if self.data.insert(ino, data).is_none() {
-            panic!("replace called on unknown inode");
-        }
+        self.data.insert(ino, data);
     }
 
     // Stores data and returns the inode for it.
@@ -128,10 +167,134 @@ impl InodeTracker {
         self.next_inode += 1;
         ino
     }
+
+    /// Records that the kernel was handed `delta` more references to `ino`,
+    /// e.g. one per successful `lookup` reply or per `readdirplus` entry.
+    ///
+    /// The caller must have ensured `ino`'s data is present (it just handed the
+    /// kernel an `Entry` for it); the count is what a later [`Self::forget`]
+    /// draws back down.
+    pub fn increment_lookup(&mut self, ino: u64, delta: u64) {
+        *self.lookup_counts.entry(ino).or_insert(0) += delta;
+    }
+
+    /// Drops `nlookup` of the kernel's outstanding references to `ino`, as
+    /// requested by a FORGET. When the last reference is dropped the inode is
+    /// evicted (see [`Self::evict`]).
+    ///
+    /// A FORGET for an inode with no recorded references is ignored: either it
+    /// was never handed to the kernel with an `Entry`, or it has already been
+    /// forgotten.
+    pub fn forget(&mut self, ino: u64, nlookup: u64) {
+        let Some(count) = self.lookup_counts.get_mut(&ino) else {
+            return;
+        };
+
+        *count = count.saturating_sub(nlookup);
+        if *count == 0 {
+            self.lookup_counts.remove(&ino);
+            self.evict(ino);
+        }
+    }
+
+    /// Removes an inode's data and the reverse-lookup entry that resolves to it.
+    ///
+    /// The reverse entry is only removed if it still points at `ino`: content
+    /// that was re-`put` after `ino` was handed out (allocating a newer inode
+    /// for the same content) owns the mapping now and must not be disturbed.
+    ///
+    /// If `ino` was a *populated* directory, its children are swept: any child
+    /// that has no outstanding lookup count is evicted too. Such children were
+    /// allocated by directory enumeration (`readdir` hands out `d_ino` values
+    /// but takes no reference) or were reinstated by [`Self::restore`] and never
+    /// looked up, so nothing but this parent kept them around; the kernel holds
+    /// no reference to a zero-count inode by definition. Without the sweep an
+    /// enumerate-only workload would still grow the tracker without bound, since
+    /// no FORGET ever names those children.
+    ///
+    /// The sweep does not recurse in practice: a swept child can only be a leaf
+    /// or a not-yet-explored ([`DirectoryInodeData::Sparse`]) directory. A
+    /// directory becomes [`DirectoryInodeData::Populated`] only through a
+    /// `get_directory_children` call, which the kernel can only make after a
+    /// lookup that raised the directory's count above zero; dropping back to
+    /// zero would already have evicted it. So a zero-count inode is never a
+    /// populated directory, and evicting one finds no further children to sweep.
+    fn evict(&mut self, ino: u64) {
+        let Some(data) = self.data.remove(&ino) else {
+            return;
+        };
+
+        match &*data {
+            InodeData::Regular(digest, _, _) => {
+                if self.blob_digest_to_inode.get(digest) == Some(&ino) {
+                    self.blob_digest_to_inode.remove(digest);
+                }
+            }
+            InodeData::Symlink(target) => {
+                if self.symlink_target_to_inode.get(target) == Some(&ino) {
+                    self.symlink_target_to_inode.remove(target);
+                }
+            }
+            InodeData::Directory(DirectoryInodeData::Sparse(digest, _)) => {
+                if self.directory_digest_to_inode.get(digest) == Some(&ino) {
+                    self.directory_digest_to_inode.remove(digest);
+                }
+            }
+            InodeData::Directory(DirectoryInodeData::Populated(digest, children)) => {
+                if self.directory_digest_to_inode.get(digest) == Some(&ino) {
+                    self.directory_digest_to_inode.remove(digest);
+                }
+
+                // Sweep children the kernel no longer references.
+                let sweepable: Vec<u64> = children
+                    .iter()
+                    .map(|(child_ino, _, _)| *child_ino)
+                    .filter(|child_ino| !self.lookup_counts.contains_key(child_ino))
+                    .collect();
+                for child_ino in sweepable {
+                    self.evict(child_ino);
+                }
+            }
+        }
+    }
+
+    /// Reinstates `data` under a specific inode number that the kernel still
+    /// references but which was evicted while a parent directory kept caching
+    /// it (see [`super::SnixStoreFs::get_directory_children`]).
+    ///
+    /// This is a no-op if the inode is already present. The content's
+    /// reverse-lookup entry is restored only if it is currently vacant, so a
+    /// newer inode allocated for the same content keeps ownership of the
+    /// mapping. The lookup count is not touched: the reference that kept the
+    /// parent alive is re-counted by the caller when it hands the entry out.
+    pub fn restore(&mut self, ino: u64, data: InodeData) {
+        if self.data.contains_key(&ino) {
+            return;
+        }
+
+        match &data {
+            InodeData::Regular(digest, _, _) => {
+                self.blob_digest_to_inode.entry(*digest).or_insert(ino);
+            }
+            InodeData::Symlink(target) => {
+                self.symlink_target_to_inode
+                    .entry(target.clone())
+                    .or_insert(ino);
+            }
+            InodeData::Directory(DirectoryInodeData::Sparse(digest, _))
+            | InodeData::Directory(DirectoryInodeData::Populated(digest, _)) => {
+                self.directory_digest_to_inode.entry(*digest).or_insert(ino);
+            }
+        }
+
+        self.data.insert(ino, Arc::new(data));
+    }
 }
 
 #[cfg(test)]
 mod tests {
+    use std::sync::Arc;
+
     use crate::fixtures;
 
     use super::InodeData;
@@ -204,4 +367,215 @@ mod tests {
         // inserting another file should return a different ino
         assert_ne!(ino, inode_tracker.put(InodeData::Symlink("target2".into())));
     }
+
+    fn blob_a() -> InodeData {
+        InodeData::Regular(
+            *fixtures::BLOB_A_DIGEST,
+            fixtures::BLOB_A.len() as u64,
+            false,
+        )
+    }
+
+    /// A single lookup followed by a matching forget evicts the inode.
+    #[test]
+    fn lookup_forget_cycle() {
+        let mut inode_tracker = InodeTracker::default();
+        let ino = inode_tracker.put(blob_a());
+
+        // The kernel is handed one reference.
+        inode_tracker.increment_lookup(ino, 1);
+        assert!(inode_tracker.get(ino).is_some());
+
+        // Forgetting that reference drops the inode.
+        inode_tracker.forget(ino, 1);
+        assert!(
+            inode_tracker.get(ino).is_none(),
+            "inode must be evicted once its last reference is forgotten"
+        );
+    }
+
+    /// Forgetting fewer references than are outstanding leaves the inode alive.
+    #[test]
+    fn partial_forget_keeps_inode() {
+        let mut inode_tracker = InodeTracker::default();
+        let ino = inode_tracker.put(blob_a());
+
+        // Three references handed out (e.g. one lookup plus two readdirplus).
+        inode_tracker.increment_lookup(ino, 3);
+
+        // Forgetting two of them must not evict.
+        inode_tracker.forget(ino, 2);
+        assert!(
+            inode_tracker.get(ino).is_some(),
+            "inode with outstanding references must survive"
+        );
+
+        // The final reference does.
+        inode_tracker.forget(ino, 1);
+        assert!(inode_tracker.get(ino).is_none());
+    }
+
+    /// Deduplicated lookups accumulate on one count; eviction waits for the
+    /// last one.
+    #[test]
+    fn dedup_accumulates_then_evicts() {
+        let mut inode_tracker = InodeTracker::default();
+
+        // The same content looked up under two names shares one inode.
+        let ino = inode_tracker.put(blob_a());
+        assert_eq!(ino, inode_tracker.put(blob_a()));
+        inode_tracker.increment_lookup(ino, 1);
+        inode_tracker.increment_lookup(ino, 1);
+
+        // A forget for one of the two references keeps the inode alive.
+        inode_tracker.forget(ino, 1);
+        assert!(inode_tracker.get(ino).is_some());
+
+        // Forgetting the remaining reference evicts it.
+        inode_tracker.forget(ino, 1);
+        assert!(inode_tracker.get(ino).is_none());
+    }
+
+    /// Eviction clears the reverse-lookup entry, so re-`put`ting the same
+    /// content allocates a fresh inode rather than resurrecting the old number.
+    #[test]
+    fn eviction_frees_reverse_map() {
+        let mut inode_tracker = InodeTracker::default();
+        let ino = inode_tracker.put(blob_a());
+        inode_tracker.increment_lookup(ino, 1);
+        inode_tracker.forget(ino, 1);
+        assert!(inode_tracker.get(ino).is_none());
+
+        // The same content must now get a *new* inode number.
+        let new_ino = inode_tracker.put(blob_a());
+        assert_ne!(
+            ino, new_ino,
+            "a re-put after eviction must not resurrect the old inode number"
+        );
+    }
+
+    /// A forget for an inode with no outstanding references is a harmless no-op,
+    /// and never underflows the count into an eviction.
+    #[test]
+    fn forget_unknown_is_noop() {
+        let mut inode_tracker = InodeTracker::default();
+        // Never looked up: no recorded references.
+        inode_tracker.forget(23, 1);
+
+        let ino = inode_tracker.put(blob_a());
+        // Put but never looked up: forgetting must not evict.
+        inode_tracker.forget(ino, 1);
+        assert!(inode_tracker.get(ino).is_some());
+    }
+
+    /// A directory can reinstate a child inode the kernel still references after
+    /// it was evicted, under the very same inode number.
+    #[test]
+    fn restore_reinstates_evicted_inode() {
+        let mut inode_tracker = InodeTracker::default();
+        let ino = inode_tracker.put(blob_a());
+        inode_tracker.increment_lookup(ino, 1);
+        inode_tracker.forget(ino, 1);
+        assert!(inode_tracker.get(ino).is_none());
+
+        inode_tracker.restore(ino, blob_a());
+        assert!(inode_tracker.get(ino).is_some());
+        // With the reverse mapping restored, a put resolves to the same inode.
+        assert_eq!(ino, inode_tracker.put(blob_a()));
+    }
+
+    /// Populates a directory inode holding the given child inodes and returns it.
+    fn put_dir_with_children(inode_tracker: &mut InodeTracker, children: &[u64]) -> u64 {
+        use super::DirectoryInodeData;
+        use crate::{Node, path::PathComponent};
+
+        let digest = fixtures::DIRECTORY_WITH_KEEP.digest();
+        let dir = inode_tracker.put(InodeData::Directory(DirectoryInodeData::Sparse(
+            digest,
+            fixtures::DIRECTORY_WITH_KEEP.size(),
+        )));
+
+        let kids: Vec<(u64, PathComponent, Node)> = children
+            .iter()
+            .enumerate()
+            .map(|(i, &ino)| {
+                let name = format!("c{i}");
+                let name: PathComponent = name.as_str().try_into().unwrap();
+                (
+                    ino,
+                    name,
+                    Node::File {
+                        digest: *fixtures::BLOB_A_DIGEST,
+                        size: 0,
+                        executable: false,
+                    },
+                )
+            })
+            .collect();
+
+        inode_tracker.replace(
+            dir,
+            Arc::new(InodeData::Directory(DirectoryInodeData::Populated(
+                digest, kids,
+            ))),
+        );
+        dir
+    }
+
+    /// A directory's zero-count children -- allocated by enumeration and never
+    /// looked up -- are swept when the directory is evicted, while children the
+    /// kernel still references survive.
+    #[test]
+    fn eviction_sweeps_unreferenced_children() {
+        let mut inode_tracker = InodeTracker::default();
+
+        let child_a = inode_tracker.put(blob_a());
+        let child_b = inode_tracker.put(InodeData::Regular(
+            *fixtures::BLOB_B_DIGEST,
+            fixtures::BLOB_B.len() as u64,
+            false,
+        ));
+
+        let dir = put_dir_with_children(&mut inode_tracker, &[child_a, child_b]);
+
+        // The directory was looked up, and so was child_b -- but not child_a.
+        inode_tracker.increment_lookup(dir, 1);
+        inode_tracker.increment_lookup(child_b, 1);
+
+        // Forgetting the directory evicts it and sweeps the unreferenced child,
+        // while the still-referenced child survives.
+        inode_tracker.forget(dir, 1);
+        assert!(
+            inode_tracker.get(dir).is_none(),
+            "directory must be evicted"
+        );
+        assert!(
+            inode_tracker.get(child_a).is_none(),
+            "a zero-count child must be swept"
+        );
+        assert!(
+            inode_tracker.get(child_b).is_some(),
+            "a referenced child must survive the sweep"
+        );
+    }
+
+    /// Enumerate-only: a directory whose children were never looked up is fully
+    /// reclaimed once the directory is forgotten.
+    #[test]
+    fn eviction_sweeps_all_when_enumerate_only() {
+        let mut inode_tracker = InodeTracker::default();
+
+        let child = inode_tracker.put(blob_a());
+        let dir = put_dir_with_children(&mut inode_tracker, &[child]);
+
+        // Only the directory was looked up (to enumerate it); the child was not.
+        inode_tracker.increment_lookup(dir, 1);
+
+        inode_tracker.forget(dir, 1);
+        assert!(inode_tracker.get(dir).is_none());
+        assert!(
+            inode_tracker.get(child).is_none(),
+            "an unreferenced child must be swept"
+        );
+    }
 }
