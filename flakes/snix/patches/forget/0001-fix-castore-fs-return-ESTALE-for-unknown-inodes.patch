From bfac0418c0b1161a89b1f75dc14f33d7515b7d20 Mon Sep 17 00:00:00 2001
From: Arbion Halili <a.halili@protonmail.com>
Date: Fri, 31 Jul 2026 15:19:12 +0100
Subject: [PATCH 1/2] fix(castore/fs): return ESTALE for unknown inodes

The filesystem panicked (unwrap/expect) whenever a request named an inode
the tracker did not know about. That never happened while the tracker only
ever grew, but it is not a safe assumption: once inodes can be evicted, the
kernel is entitled to race a request against its own FORGET, and a virtio-fs
guest can send an arbitrary inode number at any time.

Audit every inode_tracker consumer (getattr, lookup, open, read, readlink,
getxattr, listxattr, get_directory_children, and the root-name resolver) and
turn a missing inode into ESTALE -- the errno the kernel expects for a handle
that no longer refers to anything -- instead of unwinding the server thread.

No inode is evicted yet, so this is behaviour-preserving on the happy path;
it only replaces panics with the correct error. A follow-up change adds the
eviction that makes stale inodes reachable in the first place.

Co-Authored-By: Claude Fable 5 <noreply@anthropic.com>
---
 snix/castore/src/fs/mod.rs | 161 ++++++++++++++++++++++++++++++++-----
 1 file changed, 139 insertions(+), 22 deletions(-)

diff --git a/snix/castore/src/fs/mod.rs b/snix/castore/src/fs/mod.rs
index 380badf..b67465a 100644
--- a/snix/castore/src/fs/mod.rs
+++ b/snix/castore/src/fs/mod.rs
@@ -180,7 +180,11 @@ where
         &self,
         ino: u64,
     ) -> io::Result<(B3Digest, Vec<(u64, PathComponent, Node)>)> {
-        let data = self.inode_tracker.read().get(ino).unwrap();
+        let data = self
+            .inode_tracker
+            .read()
+            .get(ino)
+            .ok_or_else(|| io::Error::from_raw_os_error(libc::ESTALE))?;
         match *data {
             // if it's populated already, return children.
             InodeData::Directory(DirectoryInodeData::Populated(parent_digest, ref children)) => {
@@ -259,7 +263,7 @@ where
                 self.inode_tracker
                     .read()
                     .get(inode)
-                    .expect("must exist")
+                    .ok_or_else(|| io::Error::from_raw_os_error(libc::ESTALE))?
                     .to_owned(),
             ));
         }
@@ -280,7 +284,10 @@ where
                 if let Some(ino) = self.root_nodes.read().get(name) {
                     return Ok((
                         *ino,
-                        self.inode_tracker.read().get(*ino).expect("must exist"),
+                        self.inode_tracker
+                            .read()
+                            .get(*ino)
+                            .ok_or_else(|| io::Error::from_raw_os_error(libc::ESTALE))?,
                     ));
                 }
 
@@ -424,7 +431,7 @@ where
                 self.inode_tracker
                     .read()
                     .get(inode)
-                    .ok_or_else(|| io::Error::from_raw_os_error(libc::ENOENT))?
+                    .ok_or_else(|| io::Error::from_raw_os_error(libc::ESTALE))?
                     .as_ref(),
                 inode,
             )
@@ -477,7 +484,7 @@ where
             self.inode_tracker
                 .read()
                 .get(ino)
-                .ok_or_else(|| io::Error::from_raw_os_error(libc::ENOENT))?
+                .ok_or_else(|| io::Error::from_raw_os_error(libc::ESTALE))?
                 .as_ref(),
             ino,
         );
@@ -732,8 +739,13 @@ where
             return Err(io::Error::from_raw_os_error(libc::ENOSYS));
         }
 
-        // lookup the inode
-        match *self.inode_tracker.read().get(inode).unwrap() {
+        // lookup the inode; a request for an inode we no longer track is stale.
+        let inode_data = self
+            .inode_tracker
+            .read()
+            .get(inode)
+            .ok_or_else(|| io::Error::from_raw_os_error(libc::ESTALE))?;
+        match *inode_data {
             // read is invalid on non-files.
             InodeData::Directory(..) | InodeData::Symlink(_) => {
                 warn!("is directory");
@@ -873,8 +885,13 @@ where
             return Err(io::Error::from_raw_os_error(libc::ENOSYS));
         }
 
-        // lookup the inode
-        match *self.inode_tracker.read().get(inode).unwrap() {
+        // lookup the inode; a request for an inode we no longer track is stale.
+        let inode_data = self
+            .inode_tracker
+            .read()
+            .get(inode)
+            .ok_or_else(|| io::Error::from_raw_os_error(libc::ESTALE))?;
+        match *inode_data {
             InodeData::Directory(..) | InodeData::Regular(..) => {
                 Err(io::Error::from_raw_os_error(libc::EINVAL))
             }
@@ -894,12 +911,13 @@ where
             return Err(io::Error::from_raw_os_error(libc::ENOSYS));
         }
 
-        // Peek at the inode requested, and construct the response.
+        // Peek at the inode requested, and construct the response. A request
+        // for an inode we no longer track is stale.
         let digest_str = match *self
             .inode_tracker
             .read()
             .get(inode)
-            .ok_or_else(|| io::Error::from_raw_os_error(libc::ENODATA))?
+            .ok_or_else(|| io::Error::from_raw_os_error(libc::ESTALE))?
         {
             InodeData::Directory(DirectoryInodeData::Sparse(ref digest, _))
             | InodeData::Directory(DirectoryInodeData::Populated(ref digest, _))
@@ -935,21 +953,26 @@ where
             return Err(io::Error::from_raw_os_error(libc::ENOSYS));
         }
 
+        // A request for an inode we no longer track is stale.
+        let inode_data = self
+            .inode_tracker
+            .read()
+            .get(inode)
+            .ok_or_else(|| io::Error::from_raw_os_error(libc::ESTALE))?;
+
         // determine the (\0-terminated list) to of xattr keys present, depending on the type of the inode.
         let xattrs_names = {
             let mut out = Vec::new();
-            if let Some(inode_data) = self.inode_tracker.read().get(inode) {
-                match *inode_data {
-                    InodeData::Directory(_) => {
-                        out.extend_from_slice(XATTR_NAME_DIRECTORY_DIGEST);
-                        out.push_byte(b'\x00');
-                    }
-                    InodeData::Regular(..) => {
-                        out.extend_from_slice(XATTR_NAME_BLOB_DIGEST);
-                        out.push_byte(b'\x00');
-                    }
-                    _ => {}
+            match *inode_data {
+                InodeData::Directory(_) => {
+                    out.extend_from_slice(XATTR_NAME_DIRECTORY_DIGEST);
+                    out.push_byte(b'\x00');
                 }
+                InodeData::Regular(..) => {
+                    out.extend_from_slice(XATTR_NAME_BLOB_DIGEST);
+                    out.push_byte(b'\x00');
+                }
+                _ => {}
             }
             out
         };
@@ -963,3 +986,97 @@ where
         }
     }
 }
