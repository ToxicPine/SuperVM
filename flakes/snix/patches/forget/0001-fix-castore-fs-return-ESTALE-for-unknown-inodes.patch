+#[cfg(test)]
+mod tests {
+    use std::collections::BTreeMap;
+    use std::sync::Arc;
+
+    use fuse_backend_rs::api::filesystem::{Context, FileSystem, ROOT_ID};
+
+    use super::{FSSettings, SnixStoreFs};
+    use crate::blobservice::{BlobService, MemoryBlobService};
+    use crate::directoryservice::DirectoryService;
+    use crate::{Node, path::PathComponent};
+
+    type TestFs =
+        SnixStoreFs<Arc<dyn BlobService>, Arc<dyn DirectoryService>, Arc<BTreeMap<PathComponent, Node>>>;
+
+    /// Builds a filesystem over the given root nodes.
+    ///
+    /// The returned runtime must be kept alive for as long as the filesystem:
+    /// its handle drives the blocking castore calls, and the synchronous
+    /// [FileSystem] methods have to be invoked from outside it (never from a
+    /// runtime worker thread), exactly as the FUSE and virtio-fs servers do.
+    fn make_fs(
+        root_nodes: BTreeMap<PathComponent, Node>,
+        settings: FSSettings,
+    ) -> (tokio::runtime::Runtime, TestFs) {
+        let rt = tokio::runtime::Builder::new_multi_thread()
+            .worker_threads(1)
+            .enable_all()
+            .build()
+            .expect("build runtime");
+        let blob_service = Arc::new(MemoryBlobService::default()) as Arc<dyn BlobService>;
+        let directory_service =
+            Arc::new(crate::utils::gen_test_directory_service()) as Arc<dyn DirectoryService>;
+        let fs = SnixStoreFs::new(
+            blob_service,
+            directory_service,
+            Arc::new(root_nodes),
+            settings,
+            rt.handle().clone(),
+        );
+        (rt, fs)
+    }
+
+    /// Accessing an inode the tracker never handed out (or has already evicted)
+    /// must fail with ESTALE rather than panic, matching the FUSE contract for a
+    /// forgotten inode.
+    #[test]
+    fn unknown_inode_is_stale() {
+        let (_rt, fs) = make_fs(
+            BTreeMap::new(),
+            FSSettings {
+                show_xattr: true,
+                ..Default::default()
+            },
+        );
+        let ctx = Context::default();
+        const UNKNOWN: u64 = 42;
+
+        assert_eq!(
+            fs.getattr(&ctx, UNKNOWN, None).unwrap_err().raw_os_error(),
+            Some(libc::ESTALE),
+        );
+        assert_eq!(
+            fs.open(&ctx, UNKNOWN, 0, 0).unwrap_err().raw_os_error(),
+            Some(libc::ESTALE),
+        );
+        assert_eq!(
+            fs.readlink(&ctx, UNKNOWN).unwrap_err().raw_os_error(),
+            Some(libc::ESTALE),
+        );
+        // GetxattrReply / ListxattrReply do not implement Debug, so match
+        // rather than unwrap_err.
+        let name = std::ffi::CString::new("user.snix.castore.blob.digest").unwrap();
+        match fs.getxattr(&ctx, UNKNOWN, &name, 0) {
+            Err(e) => assert_eq!(e.raw_os_error(), Some(libc::ESTALE)),
+            Ok(_) => panic!("getxattr on unknown inode should be ESTALE"),
+        }
+        match fs.listxattr(&ctx, UNKNOWN, 0) {
+            Err(e) => assert_eq!(e.raw_os_error(), Some(libc::ESTALE)),
+            Ok(_) => panic!("listxattr on unknown inode should be ESTALE"),
+        }
+    }
+
+    /// The root inode is special: it is always resolvable, even on an empty
+    /// tree, and never lives in the inode tracker.
+    #[test]
+    fn root_getattr_ok() {
+        let (_rt, fs) = make_fs(BTreeMap::new(), FSSettings::default());
+        let ctx = Context::default();
+        let (attr, _) = fs.getattr(&ctx, ROOT_ID, None).expect("root getattr");
+        assert_eq!(attr.st_ino, ROOT_ID);
+    }
+}
